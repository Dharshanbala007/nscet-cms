<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="PendingFeesReport" pageWidth="842" pageHeight="595"
              columnWidth="762" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40"
              orientation="Landscape">

    <parameter name="COLLEGE_NAME" class="java.lang.String"/>
    <parameter name="ACADEMIC_YEAR" class="java.lang.String"/>
    <parameter name="DEPARTMENT" class="java.lang.String"/>
    <parameter name="SEMESTER" class="java.lang.Integer"/>

    <field name="rollNumber" class="java.lang.String"/>
    <field name="studentName" class="java.lang.String"/>
    <field name="quota" class="java.lang.String"/>
    <field name="admissionType" class="java.lang.String"/>
    <field name="community" class="java.lang.String"/>
    <field name="previousPending" class="java.math.BigDecimal"/>
    <field name="tuitionFee" class="java.math.BigDecimal"/>
    <field name="otherFee" class="java.math.BigDecimal"/>
    <field name="scholarshipAmount" class="java.math.BigDecimal"/>
    <field name="annaUnivReg" class="java.math.BigDecimal"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="paidAmount" class="java.math.BigDecimal"/>
    <field name="balanceAmount" class="java.math.BigDecimal"/>
    <field name="fineAmount" class="java.math.BigDecimal"/>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="762" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Nadar Saraswathi College of Engineering and Technology, Theni]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="30" width="762" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[PENDING FEES REPORT]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="75" width="762" height="2"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="35">
            <staticText>
                <reportElement x="0" y="0" width="50" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[S.No]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="80" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Roll No]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="0" width="120" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Student Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="0" width="60" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Quota]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="60" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Pre.Pend]]></text>
            </staticText>
            <staticText>
                <reportElement x="370" y="0" width="60" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Tuition]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="0" width="60" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Other]]></text>
            </staticText>
            <staticText>
                <reportElement x="490" y="0" width="60" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
            <staticText>
                <reportElement x="550" y="0" width="60" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Paid]]></text>
            </staticText>
            <staticText>
                <reportElement x="610" y="0" width="60" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Balance]]></text>
            </staticText>
            <staticText>
                <reportElement x="670" y="0" width="50" height="35"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Fine]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{rollNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="130" y="0" width="120" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{studentName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="60" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quota}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="310" y="0" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{previousPending}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="0" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tuitionFee}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="0" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{otherFee}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="490" y="0" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="550" y="0" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{paidAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="610" y="0" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{balanceAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="670" y="0" width="50" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fineAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="25">
            <line>
                <reportElement x="0" y="0" width="762" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="200" height="15"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Total Students:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="5" width="100" height="15"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
