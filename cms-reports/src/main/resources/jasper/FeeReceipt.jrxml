<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="FeeReceipt" pageWidth="595" pageHeight="595" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="15" bottomMargin="15">

    <!-- Parameters for Pre-printed Stationery Overlay (Black Text Only) -->
    <parameter name="RECEIPT_NO" class="java.lang.String"/>
    <parameter name="RECEIPT_DATE" class="java.lang.String"/>
    <parameter name="STUDENT_NAME" class="java.lang.String"/>
    <parameter name="ROLL_NO" class="java.lang.String"/>
    <parameter name="REG_NO" class="java.lang.String"/>
    <parameter name="DEPARTMENT" class="java.lang.String"/>
    <parameter name="SEMESTER" class="java.lang.String"/>
    <parameter name="TOTAL_AMOUNT" class="java.lang.String"/>
    <parameter name="AMOUNT_IN_WORDS" class="java.lang.String"/>

    <!-- Fields for Line Items -->
    <field name="slNo" class="java.lang.Integer"/>
    <field name="semester" class="java.lang.String"/>
    <field name="feeName" class="java.lang.String"/>
    <field name="feeAmount" class="java.math.BigDecimal"/>

    <!-- Pre-printed Header Offsets -->
    <title>
        <band height="180">
            <!-- 1. Receipt No (Positioned after pre-printed 'No. :') -->
            <textField isBlankWhenNull="true">
                <reportElement x="65" y="90" width="200" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{RECEIPT_NO}]]></textFieldExpression>
            </textField>

            <!-- 2. Receipt Date (Positioned after pre-printed 'Date :') -->
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="90" width="130" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{RECEIPT_DATE}]]></textFieldExpression>
            </textField>

            <!-- 3. Student Name (Positioned after pre-printed 'Name :') -->
            <textField isBlankWhenNull="true">
                <reportElement x="75" y="112" width="250" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{STUDENT_NAME}]]></textFieldExpression>
            </textField>

            <!-- 4. Department (Positioned after pre-printed 'Dept.:') -->
            <textField isBlankWhenNull="true">
                <reportElement x="405" y="112" width="100" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{DEPARTMENT}]]></textFieldExpression>
            </textField>

            <!-- 5. Roll No (Positioned after pre-printed 'Roll No.:') -->
            <textField isBlankWhenNull="true">
                <reportElement x="85" y="134" width="240" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ROLL_NO} != null ? $P{ROLL_NO} : $P{REG_NO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Detail Band for Particulars Table Overlay -->
    <detail>
        <band height="20">
            <!-- S.No (Under pre-printed 'SI No.') -->
            <textField isBlankWhenNull="true">
                <reportElement x="10" y="2" width="35" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{slNo} != null ? $F{slNo} : "1"]]></textFieldExpression>
            </textField>

            <!-- Sem (Under pre-printed 'Sem') -->
            <textField isBlankWhenNull="true">
                <reportElement x="50" y="2" width="35" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{semester} != null ? $F{semester} : ($P{SEMESTER} != null ? $P{SEMESTER} : "1")]]></textFieldExpression>
            </textField>

            <!-- Particulars (Under pre-printed 'Particulars') -->
            <textField isBlankWhenNull="true">
                <reportElement x="95" y="2" width="270" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font size="9.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{feeName}]]></textFieldExpression>
            </textField>

            <!-- Amount (Under pre-printed 'Amount') -->
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="375" y="2" width="110" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{feeAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Summary / Total & Words Overlay -->
    <summary>
        <band height="100">
            <!-- Total Amount (In pre-printed box next to 'TOTAL ₹') -->
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="18" width="110" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_AMOUNT}]]></textFieldExpression>
            </textField>

            <!-- Amount in Words (After pre-printed 'Rupees') -->
            <textField isBlankWhenNull="true">
                <reportElement x="60" y="45" width="320" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="9.5" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{AMOUNT_IN_WORDS} != null ? "(" + $P{AMOUNT_IN_WORDS} + ")" : ""]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
