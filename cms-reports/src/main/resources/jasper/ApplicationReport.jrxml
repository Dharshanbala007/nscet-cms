<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ApplicationReport" pageWidth="842" pageHeight="595"
              columnWidth="762" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40"
              orientation="Landscape">

    <field name="slNo" class="java.lang.Integer"/>
    <field name="appNo" class="java.lang.String"/>
    <field name="studentName" class="java.lang.String"/>
    <field name="address" class="java.lang.String"/>
    <field name="hscMark" class="java.lang.String"/>
    <field name="cutOff" class="java.lang.String"/>
    <field name="doteCutOff" class="java.lang.String"/>
    <field name="community" class="java.lang.String"/>
    <field name="mgGq" class="java.lang.String"/>
    <field name="amountPaid" class="java.math.BigDecimal"/>
    <field name="dept" class="java.lang.String"/>
    <field name="schoolName" class="java.lang.String"/>
    <field name="hostel" class="java.lang.String"/>
    <field name="busStop" class="java.lang.String"/>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="762" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Nadar Saraswathi College of Engineering and Technology, Theni]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="30" width="762" height="20"/>
                <textElement textAlignment="Center">
                    <font size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[STUDENT APPLICATION DETAIL REPORT]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="65" width="762" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="30" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[S.No]]></text>
            </staticText>
            <staticText>
                <reportElement x="30" y="0" width="60" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[App No]]></text>
            </staticText>
            <staticText>
                <reportElement x="90" y="0" width="100" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Student Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="0" width="90" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Address]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="0" width="50" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[HSC Mark]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="0" width="45" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Cut Off]]></text>
            </staticText>
            <staticText>
                <reportElement x="375" y="0" width="50" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[DOTE Cutoff]]></text>
            </staticText>
            <staticText>
                <reportElement x="425" y="0" width="45" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Community]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="0" width="45" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[MQ/GQ]]></text>
            </staticText>
            <staticText>
                <reportElement x="515" y="0" width="55" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Paid]]></text>
            </staticText>
            <staticText>
                <reportElement x="570" y="0" width="40" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Dept]]></text>
            </staticText>
            <staticText>
                <reportElement x="610" y="0" width="75" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[School]]></text>
            </staticText>
            <staticText>
                <reportElement x="685" y="0" width="77" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Bus Stop]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="30" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{slNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="30" y="0" width="60" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{appNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="90" y="0" width="100" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{studentName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="190" y="0" width="90" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{address}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{hscMark}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="0" width="45" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cutOff}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="375" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{doteCutOff}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="425" y="0" width="45" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{community}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="470" y="0" width="45" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{mgGq}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="515" y="0" width="55" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{amountPaid}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="570" y="0" width="40" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{dept}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="610" y="0" width="75" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{schoolName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="685" y="0" width="77" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{busStop}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
