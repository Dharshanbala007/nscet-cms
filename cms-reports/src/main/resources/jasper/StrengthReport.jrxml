<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="StrengthReport" pageWidth="842" pageHeight="595"
              columnWidth="762" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40"
              orientation="Landscape">

    <parameter name="COLLEGE_NAME" class="java.lang.String"/>
    <parameter name="ACADEMIC_YEAR" class="java.lang.String"/>
    <parameter name="REPORT_TYPE" class="java.lang.String"/>

    <field name="department" class="java.lang.String"/>
    <field name="staffCode" class="java.lang.String"/>
    <field name="staffName" class="java.lang.String"/>
    <field name="designation" class="java.lang.String"/>
    <field name="category" class="java.lang.String"/>
    <field name="sex" class="java.lang.String"/>
    <field name="dateOfJoining" class="java.time.LocalDate"/>
    <field name="phone" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="762" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Nadar Saraswathi College of Engineering and Technology, Theni]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="30" width="762" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[STAFF STRENGTH REPORT]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="55" width="200" height="15"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Academic Year:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="55" width="200" height="15"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{ACADEMIC_YEAR}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="75" width="762" height="2"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="60" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[S.No]]></text>
            </staticText>
            <staticText>
                <reportElement x="60" y="0" width="80" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Staff Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="140" y="0" width="180" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="120" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Designation]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="80" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Category]]></text>
            </staticText>
            <staticText>
                <reportElement x="520" y="0" width="60" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Gender]]></text>
            </staticText>
            <staticText>
                <reportElement x="580" y="0" width="100" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date of Joining]]></text>
            </staticText>
            <staticText>
                <reportElement x="680" y="0" width="82" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Phone]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="60" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="60" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{staffCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="0" width="180" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{staffName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="120" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{designation}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="440" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{category}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="520" y="0" width="60" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{sex}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="580" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dateOfJoining}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="680" y="0" width="82" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{phone}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="30">
            <line>
                <reportElement x="0" y="0" width="762" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="200" height="20"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Total Staff:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="5" width="100" height="20"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
