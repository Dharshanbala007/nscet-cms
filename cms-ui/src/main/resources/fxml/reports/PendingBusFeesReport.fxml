<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.PendingBusFeesReportController"
      styleClass="master-container" spacing="10">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
    
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="Pending Bus Fees" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Print / Export" styleClass="btn-secondary" onAction="#handleExport"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="form-container">
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
        <Label text="Acad. Year:"/>
        <ComboBox fx:id="academicYearCombo" prefWidth="100"/>
        <Label text="Term:"/>
        <ComboBox fx:id="termCombo" prefWidth="80"/>
        <Label text="Dept:"/>
        <ComboBox fx:id="deptCombo" prefWidth="90"/>
        <Label text="Semester:"/>
        <ComboBox fx:id="semesterCombo" prefWidth="70"/>
        <Button text="Generate" styleClass="btn-primary" onAction="#handleGenerate"/>
    </HBox>

    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="deptCol" text="Dept" prefWidth="60"/>
            <TableColumn fx:id="rollNoCol" text="Roll No" prefWidth="110"/>
            <TableColumn fx:id="nameCol" text="Student Name" prefWidth="150"/>
            <TableColumn fx:id="quotaCol" text="Quota" prefWidth="120"/>
            <TableColumn fx:id="busStopCol" text="Bus Stop Name" prefWidth="140"/>
            <TableColumn fx:id="prevPendingCol" text="Prev Pending" prefWidth="90"/>
            <TableColumn fx:id="busFeeCol" text="Bus Fee" prefWidth="90"/>
            <TableColumn fx:id="paidCol" text="Paid Amt" prefWidth="90"/>
            <TableColumn fx:id="balanceCol" text="Balance" prefWidth="90"/>
            <TableColumn fx:id="toBePaidCol" text="To Be Paid" prefWidth="90"/>
            <TableColumn fx:id="receiptNoCol" text="Receipt No" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
