<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.ApplicationReportController"
      styleClass="master-container" spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc;">

    <!-- Title Header -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Application Report" styleClass="module-title" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
    </HBox>

    <!-- Top Control Panels matching media_1788248570608.png -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        
        <!-- ToggleGroup for Report Mode -->
        <fx:define>
            <ToggleGroup fx:id="reportModeGroup"/>
        </fx:define>

        <!-- PANEL 1: SUMMARY BOX -->
        <VBox spacing="6" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-padding: 6 10 8 10; -fx-background-color: #f8fafc;">
            <RadioButton fx:id="summaryRadio" text="Summary" toggleGroup="$reportModeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <ComboBox fx:id="typeCombo" prefWidth="130" promptText="Select"/>
        </VBox>

        <!-- PANEL 2: DETAIL / ADVANCE BOX -->
        <VBox spacing="6" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-padding: 6 10 8 10; -fx-background-color: #f8fafc;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <RadioButton fx:id="detailRadio" text="Detail" selected="true" toggleGroup="$reportModeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <RadioButton fx:id="advanceRadio" text="Advance" toggleGroup="$reportModeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            </HBox>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="From:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 11px;"/>
                <DatePicker fx:id="fromDate" prefWidth="110"/>
                <Label text="To:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 11px;"/>
                <DatePicker fx:id="toDate" prefWidth="110"/>
                <Label text="Order by" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 11px;"/>
                <ComboBox fx:id="orderByCombo" prefWidth="110" promptText="Select"/>
            </HBox>
        </VBox>

        <!-- PANEL 3: CUSTOMIZE REPORT BOX -->
        <VBox spacing="6" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-padding: 6 10 8 10; -fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
            <RadioButton fx:id="customizeRadio" text="Customize Report" toggleGroup="$reportModeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <ComboBox fx:id="custField1Combo" prefWidth="130" promptText="Select"/>
                <ComboBox fx:id="custField2Combo" prefWidth="80" promptText="Select"/>
                <TextField fx:id="custValueField" promptText="Search text..." prefWidth="100" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- ACTION BUTTONS -->
        <VBox spacing="6" alignment="CENTER">
            <Button text="View" styleClass="btn-primary" prefWidth="75" onAction="#handleGenerate"/>
            <Button text="Print" styleClass="btn-secondary" prefWidth="75" onAction="#handleExport"/>
        </VBox>
    </HBox>

    <!-- Main Data Table matching media_1788248570608.png -->
    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="receiptNoCol" text="Receipt No" prefWidth="80"/>
            <TableColumn fx:id="appNoCol" text="App.No" prefWidth="75"/>
            <TableColumn fx:id="studentNameCol" text="Student Name" prefWidth="150"/>
            <TableColumn fx:id="addressCol" text="Address" prefWidth="200"/>
            <TableColumn fx:id="hscMarkCol" text="HSC Mark" prefWidth="75"/>
            <TableColumn fx:id="doteCutOffCol" text="DOTE Cut" prefWidth="70"/>
            <TableColumn fx:id="annaUnivCutOffCol" text="Anna Univ Cut off" prefWidth="110"/>
            <TableColumn fx:id="communityCol" text="Community" prefWidth="85"/>
            <TableColumn fx:id="mgGqCol" text="MQ\GQ" prefWidth="95"/>
            <TableColumn fx:id="amountCol" text="Amount Paid" prefWidth="90"/>
            <TableColumn fx:id="deptCol" text="Dept" prefWidth="65"/>
            <TableColumn fx:id="schoolNameCol" text="School Name" prefWidth="160"/>
            <TableColumn fx:id="hostelCol" text="Hostel" prefWidth="65"/>
        </columns>
    </TableView>
</VBox>
