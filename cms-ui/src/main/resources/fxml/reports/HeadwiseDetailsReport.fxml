<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.HeadwiseDetailsReportController"
      styleClass="master-container" spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc;">

    <!-- Title Header matching media_1788251955556.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Headwise Details" styleClass="module-title" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
    </HBox>

    <!-- Top Control Bar matching media_1788251955556.png & media_1788251972347.png -->
    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 12; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        
        <HBox spacing="15" alignment="CENTER_LEFT">
            <!-- Toggle Groups -->
            <fx:define>
                <ToggleGroup fx:id="paidPendingGroup"/>
                <ToggleGroup fx:id="viewTypeGroup"/>
            </fx:define>

            <!-- Box 1: Paid List / Pending List -->
            <VBox spacing="6" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-padding: 6 12 8 12; -fx-background-color: #f8fafc;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <RadioButton fx:id="paidListRadio" text="Paid List" selected="true" toggleGroup="$paidPendingGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <RadioButton fx:id="pendingListRadio" text="Pending List" toggleGroup="$paidPendingGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                </HBox>
            </VBox>

            <!-- Date Range Controls -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="From Date:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 11.5px;"/>
                <DatePicker fx:id="fromDate" prefWidth="125"/>
                <Label text="To Date:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 11.5px;"/>
                <DatePicker fx:id="toDate" prefWidth="125"/>
            </HBox>
        </HBox>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <!-- Box 2: Summary / Detail -->
            <VBox spacing="6" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-padding: 6 12 8 12; -fx-background-color: #f8fafc;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <RadioButton fx:id="summaryRadio" text="Summary" toggleGroup="$viewTypeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <RadioButton fx:id="detailRadio" text="Detail" selected="true" toggleGroup="$viewTypeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                </HBox>
            </VBox>

            <!-- Department & Semester Selection -->
            <HBox fx:id="deptSemBox" spacing="12" alignment="CENTER_LEFT">
                <Label text="Dept:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 11.5px;"/>
                <ComboBox fx:id="deptCombo" prefWidth="110" promptText="MECH"/>
                
                <Label text="Semester:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 11.5px;"/>
                <ComboBox fx:id="semesterCombo" prefWidth="80" promptText="6"/>
            </HBox>
        </HBox>

        <!-- Fees Selector & Action Buttons Row -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Fees Name:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;"/>
            <ComboBox fx:id="feesNameCombo" prefWidth="240" promptText="Breakage Fine"/>

            <Button text="View" styleClass="btn-primary" prefWidth="75" onAction="#handleGenerate"/>
            <Button text="Save" styleClass="btn-secondary" prefWidth="75"/>
            <Button text="Print" styleClass="btn-secondary" prefWidth="75" onAction="#handleExport"/>
        </HBox>
    </VBox>

    <!-- Dynamic Table View matching media_1788251955556.png & media_1788251972347.png -->
    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table"/>
</VBox>
