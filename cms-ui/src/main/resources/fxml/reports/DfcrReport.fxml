<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.DfcrReportController"
      styleClass="master-container" spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc;">

    <!-- Title Header matching media_1788253993947.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Daily Fees Collection Register" styleClass="module-title" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
    </HBox>

    <!-- Top Control Bar matching media_1788253993947.png & media_1788254005817.png -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 10 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <fx:define>
            <ToggleGroup fx:id="viewModeGroup"/>
        </fx:define>
        
        <RadioButton fx:id="detailedRadio" text="Detailed Transactions" selected="true" toggleGroup="$viewModeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <RadioButton fx:id="summaryRadio" text="Summary Register" toggleGroup="$viewModeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Date:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 11.5px;"/>
        <DatePicker fx:id="reportDatePicker" prefWidth="130"/>

        <Button text="View" styleClass="btn-primary" prefWidth="80" onAction="#handleGenerate"/>
        <Button text="Save" styleClass="btn-secondary" prefWidth="80" onAction="#handleSave"/>
        <Button text="Print" styleClass="btn-secondary" prefWidth="80" onAction="#handleExport"/>
    </HBox>

    <!-- Dynamic Table View matching media_1788253993947.png & media_1788254005817.png -->
    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table"/>
</VBox>
