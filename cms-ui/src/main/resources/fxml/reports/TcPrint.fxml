<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.TcPrintController"
      styleClass="master-container" spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc;">

    <!-- Module Title Header -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="TC \ CC Batch Print" styleClass="module-title" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
    </HBox>

    <!-- Top Selection Control Bar -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 10 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Academic Year:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;"/>
        <ComboBox fx:id="academicYearCombo" prefWidth="130"/>

        <Label text="Dept:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;"/>
        <ComboBox fx:id="deptCombo" prefWidth="250"/>

        <Label text="Certificate:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;"/>
        <ComboBox fx:id="certificateCombo" prefWidth="90"/>

        <Button text="Generate Batch" styleClass="btn-primary" prefWidth="120" onAction="#handleGenerateBatch"/>
    </HBox>

    <!-- Navigation & Batch Print Bar -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Button fx:id="prevBtn" text="◄ Previous" styleClass="btn-secondary" prefWidth="100" onAction="#handlePrevious"/>
        
        <Label fx:id="studentCounterLabel" text="Student 1 of 5 (2021FME012 - LAKSHMIPRABHA K)" 
               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1e3a8a;"/>
        
        <Button fx:id="nextBtn" text="Next ►" styleClass="btn-secondary" prefWidth="100" onAction="#handleNext"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Print Current TC" styleClass="btn-primary" prefWidth="135" onAction="#handlePrintCurrent"/>
        <Button text="Print All TCs (Batch)" prefWidth="160" style="-fx-background-color: #047857; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" onAction="#handlePrintAll"/>
    </HBox>

    <!-- TC Document Preview Container -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Transfer Certificate Document Preview:" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
        <TextArea fx:id="tcPreviewArea" VBox.vgrow="ALWAYS" editable="false"
                  style="-fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 13px; -fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-padding: 10;"/>
    </VBox>
</VBox>
