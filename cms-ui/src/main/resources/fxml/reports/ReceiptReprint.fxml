<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.ReceiptReprintController"
      styleClass="master-container" spacing="15" alignment="TOP_CENTER"
      style="-fx-padding: 15; -fx-background-color: #f8fafc;">

    <!-- Module Header -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10" maxWidth="580" style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Receipt Reprint" styleClass="module-title" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
    </HBox>

    <!-- Main Card Box matching media_1788252191405.png -->
    <VBox maxWidth="580" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);" spacing="18">
        
        <!-- Radio Group Selection Row -->
        <fx:define>
            <ToggleGroup fx:id="reprintGroup"/>
        </fx:define>
        <HBox spacing="25" alignment="CENTER">
            <RadioButton fx:id="appReceiptRadio" text="Application Receipt" toggleGroup="$reprintGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <RadioButton fx:id="nameReceiptRadio" text="Receipt with Name" toggleGroup="$reprintGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <RadioButton fx:id="noReceiptRadio" text="Receipt with No" selected="true" toggleGroup="$reprintGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </HBox>

        <!-- Form Controls Grid matching media_1788252191405.png -->
        <GridPane hgap="15" vgap="12" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints minWidth="90" prefWidth="100" halignment="RIGHT"/>
                <ColumnConstraints minWidth="150" prefWidth="170" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="80" prefWidth="90" halignment="RIGHT"/>
                <ColumnConstraints minWidth="150" prefWidth="170" hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Row 0: Receipt Date & Rec.Type -->
            <Label text="Receipt Date:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <DatePicker fx:id="receiptDate" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>

            <Label text="Rec.Type :" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="recTypeCombo" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>

            <!-- Row 1: Name & Period -->
            <Label text="Name:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="nameField" promptText="Enter Student Name" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Period :" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="periodCombo" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"/>

            <!-- Row 2: No -->
            <Label text="No:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <TextField fx:id="noField" promptText="Enter Receipt No" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>

        <!-- Action Buttons matching media_1788252191405.png -->
        <HBox alignment="CENTER" spacing="15">
            <padding><Insets top="10"/></padding>
            <Button text="Print" styleClass="btn-primary" prefWidth="90" onAction="#handlePrint"/>
            <Button text="Close" styleClass="btn-secondary" prefWidth="90" onAction="#handleClose"/>
        </HBox>
    </VBox>
</VBox>
