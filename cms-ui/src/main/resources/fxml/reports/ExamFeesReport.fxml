<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.ExamFeesReportController"
      styleClass="master-container" spacing="10">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
    
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="Exam Fees Overall Report" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Print / Export" styleClass="btn-secondary" onAction="#handleExport"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="form-container">
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
        <Label text="Year:"/>
        <ComboBox fx:id="academicYearCombo" prefWidth="100"/>
        <Label text="Dept:"/>
        <ComboBox fx:id="deptCombo" prefWidth="100"/>
        <Label text="Sem:"/>
        <ComboBox fx:id="semesterCombo" prefWidth="80"/>
        <Button text="Generate" styleClass="btn-primary" onAction="#handleGenerate"/>
    </HBox>

    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="deptCol" text="Dept" prefWidth="70"/>
            <TableColumn fx:id="rollNoCol" text="Roll No" prefWidth="120"/>
            <TableColumn fx:id="studentNameCol" text="Student Name" prefWidth="180"/>
            <TableColumn fx:id="examNameCol" text="Exam Description" prefWidth="240"/>
            <TableColumn fx:id="amountCol" text="Fee Amt" prefWidth="100"/>
            <TableColumn fx:id="paidCol" text="Paid Amt" prefWidth="100"/>
            <TableColumn fx:id="balanceCol" text="Balance" prefWidth="100"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="90"/>
        </columns>
    </TableView>
</VBox>
