<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.StrengthReportController"
      styleClass="master-container" spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc;">

    <!-- Title Header matching media_1788252377162.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Current Strength Report" styleClass="module-title" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
    </HBox>

    <!-- Top Control Bar matching media_1788252377162.png -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 12; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        
        <!-- Left Main Controls Area -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            
            <!-- Toggle Group: Summary vs Detail Box -->
            <fx:define>
                <ToggleGroup fx:id="reportTypeGroup"/>
                <ToggleGroup fx:id="customFieldGroup"/>
            </fx:define>
            
            <HBox spacing="25" alignment="CENTER" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-padding: 6 15 8 15; -fx-background-color: #f8fafc;" maxWidth="420">
                <RadioButton fx:id="summaryRadio" text="Summary" toggleGroup="$reportTypeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <RadioButton fx:id="detailRadio" text="Detail" selected="true" toggleGroup="$reportTypeGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            </HBox>

            <!-- Dropdowns Grid -->
            <GridPane hgap="12" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="90" prefWidth="100" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="130" prefWidth="150"/>
                    <ColumnConstraints minWidth="80" prefWidth="90" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="130" prefWidth="150"/>
                </columnConstraints>

                <!-- Row 0: Staff\Student & Category -->
                <Label text="Staff\Student:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="staffStudentCombo" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>

                <Label text="Category:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="categoryCombo" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>

                <!-- Row 1: Sex & Staff Type -->
                <Label text="Sex:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="sexCombo" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"/>

                <Label text="Staff Type:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <ComboBox fx:id="staffTypeCombo" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"/>
            </GridPane>

            <!-- View & Print Buttons Row -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="View" styleClass="btn-primary" prefWidth="85" onAction="#handleGenerate"/>
                <Button text="Print" styleClass="btn-secondary" prefWidth="85" onAction="#handleExport"/>
            </HBox>
        </VBox>

        <!-- Right Side Custom Field Column Options matching media_1788252377162.png -->
        <VBox spacing="10" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-padding: 10 15 10 15; -fx-background-color: #f8fafc;">
            <RadioButton fx:id="sigRadio" text="Signature" toggleGroup="$customFieldGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <RadioButton fx:id="phoneRadio" text="Phone No" toggleGroup="$customFieldGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <RadioButton fx:id="bankAccRadio" text="Bank.Acc.No" toggleGroup="$customFieldGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <RadioButton fx:id="dojRadio" text="Date of Joining" toggleGroup="$customFieldGroup" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </VBox>
    </HBox>

    <!-- Data Table View matching media_1788252377162.png -->
    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table"/>
</VBox>
