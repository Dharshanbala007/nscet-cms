<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.StudentReceiptDetailsController"
      styleClass="master-container" spacing="10">

    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
        <Label text="Student Receipt Details" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="10">
        <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>

        <!-- Top Controls matching Screenshot media_1787820253081.png -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="form-container">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>

            <Label text="Dept:"/>
            <ComboBox fx:id="deptCombo" prefWidth="100" promptText="CE"/>

            <Label text="Student Name:"/>
            <TextField fx:id="studentNameField" text="RUBASREE K" prefWidth="180"/>

            <Label text="Roll No:"/>
            <TextField fx:id="rollNoField" text="2025FCE006" prefWidth="120"/>

            <Label text="Reg No:"/>
            <TextField fx:id="regNoField" text="921025103021" prefWidth="130"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="View" styleClass="btn-primary" onAction="#handleView"/>
            <Button text="Print" styleClass="btn-secondary" onAction="#handlePrint"/>
        </HBox>

        <!-- Table View matching Screenshot media_1787820253081.png -->
        <TableView fx:id="receiptTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="receiptNoCol" text="Receipt No" prefWidth="120"/>
                <TableColumn fx:id="receiptDateCol" text="Receipt Date" prefWidth="100"/>
                <TableColumn fx:id="rollNoCol" text="Roll No" prefWidth="100"/>
                <TableColumn fx:id="particularsCol" text="Particulars" prefWidth="220"/>
                <TableColumn fx:id="amountCol" text="Amount" prefWidth="90"/>
                <TableColumn fx:id="semesterCol" text="Semester" prefWidth="70"/>
                <TableColumn fx:id="remarksCol" text="Remarks" prefWidth="250"/>
            </columns>
        </TableView>

        <!-- Bottom Summary Row -->
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="Estimated Amount:"/>
            <TextField fx:id="estimatedAmtField" prefWidth="120" editable="false"/>
            <Label text="Total Amount:"/>
            <TextField fx:id="totalAmtField" text="121025" prefWidth="130" editable="false" style="-fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</VBox>
