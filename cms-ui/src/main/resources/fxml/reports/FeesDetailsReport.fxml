<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.FeesDetailsReportController"
      styleClass="master-container" spacing="10">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
    
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="Fees Paid and Pending Details" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Print Report" styleClass="btn-secondary" onAction="#handleExport"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="form-container">
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
        <Label text="Academic Period:"/>
        <ComboBox fx:id="academicPeriodCombo" prefWidth="110"/>
        <Label text="Branch:"/>
        <ComboBox fx:id="branchCombo" prefWidth="90"/>
        <RadioButton fx:id="semwiseRadio" text="Semwise" selected="true">
            <toggleGroup><ToggleGroup fx:id="orderGroup"/></toggleGroup>
        </RadioButton>
        <RadioButton fx:id="branchwiseRadio" text="Branchwise" toggleGroup="$orderGroup"/>
        <Button text="Generate" styleClass="btn-primary" onAction="#handleGenerate"/>
    </HBox>

    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="branchCol" text="Branch" prefWidth="70"/>
            <TableColumn fx:id="semesterCol" text="Sem" prefWidth="50"/>
            <TableColumn fx:id="strengthCol" text="Strength" prefWidth="65"/>
            <TableColumn fx:id="prePendingCol" text="Pre. Pending" prefWidth="90"/>
            <TableColumn fx:id="tuitionFeeCol" text="Tuition Fee" prefWidth="100"/>
            <TableColumn fx:id="otherFeesCol" text="Other Fees" prefWidth="100"/>
            <TableColumn fx:id="busFeesCol" text="Bus Fees" prefWidth="90"/>
            <TableColumn fx:id="totalAmountCol" text="Total Amount" prefWidth="110"/>
            <TableColumn fx:id="paidAmountCol" text="Paid Amount" prefWidth="110"/>
            <TableColumn fx:id="pendingAmountCol" text="Pending Amount" prefWidth="110"/>
            <TableColumn fx:id="colAmtCol" text="Col Amt" prefWidth="95"/>
            <TableColumn fx:id="karAmtCol" text="Kar Amt" prefWidth="95"/>
            <TableColumn fx:id="busAmtCol" text="Bus Amt" prefWidth="95"/>
        </columns>
    </TableView>
</VBox>
