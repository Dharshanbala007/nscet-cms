<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.BusFeesUpdateController"
      styleClass="master-container" spacing="10" style="-fx-padding: 12; -fx-background-color: #f8fafc;">

    <!-- Title Header matching media_1788254870198.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Bus Fees Update" styleClass="module-title" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
    </HBox>

    <!-- Top Control Bar matching media_1788254870198.png -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 10 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
        <Label text="Acadamic Year:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;"/>
        <ComboBox fx:id="academicYearCombo" prefWidth="130" promptText="2026-27"/>

        <Label text="Bus Route:" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11.5px;"/>
        <ComboBox fx:id="busRouteCombo" prefWidth="260" promptText="BOOTHIPURAM &amp; RATHNA NAGAR"/>

        <Button text="View" styleClass="btn-primary" prefWidth="80" onAction="#handleLoadData"/>
        <Button text="Save" styleClass="btn-secondary" prefWidth="80" onAction="#handleSave"/>
    </HBox>

    <!-- Main Table View matching media_1788254870198.png -->
    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="routeNoCol" text="Route No" prefWidth="75"/>
            <TableColumn fx:id="routeNameCol" text="Route Name" prefWidth="220"/>
            <TableColumn fx:id="busStopNameCol" text="Bus stop Name" prefWidth="220"/>
            <TableColumn fx:id="amountCol" text="Amount" prefWidth="110"/>
            <TableColumn fx:id="academicYearCol" text="Acadmic Year" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
