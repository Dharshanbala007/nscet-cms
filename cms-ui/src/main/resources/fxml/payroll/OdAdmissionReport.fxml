<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.OdAdmissionReportController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls matching media_1787899669431.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="OD Admission Report" styleClass="module-title" minWidth="160"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="From Date:" minWidth="75"/>
        <DatePicker fx:id="fromDate" prefWidth="130" minWidth="120"/>
        <Label text="To Date:" minWidth="65"/>
        <DatePicker fx:id="toDate" prefWidth="130" minWidth="120"/>
        <Label text="Dept:" minWidth="45"/>
        <ComboBox fx:id="deptCombo" prefWidth="120" minWidth="100" promptText="Select"/>
        <Button text="View" styleClass="btn-primary" minWidth="75" onAction="#handleGenerate"/>
        <Button text="Print" styleClass="btn-secondary" minWidth="75" onAction="#handlePrint"/>
    </HBox>

    <!-- Data Table matching media_1787899676001.png -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colSlNo" text="S.NO" prefWidth="60"/>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="110"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="200"/>
            <TableColumn fx:id="colDept" text="Dept" prefWidth="90"/>
            <TableColumn fx:id="colDesig" text="Design" prefWidth="120"/>
            <TableColumn fx:id="colOdCount" text="OD Admission" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
