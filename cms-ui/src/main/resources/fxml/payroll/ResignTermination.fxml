<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.ResignTerminationController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Resign / Termination Details" styleClass="module-title"/>
    </HBox>

    <TitledPane text="Resignation &amp; Relief Form" expanded="true">
        <VBox spacing="10">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>

            <GridPane hgap="15" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="200" prefWidth="220"/>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="200" prefWidth="220"/>
                </columnConstraints>

                <Label text="Staff Member:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="staffCombo" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Relieving Date:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <DatePicker fx:id="relievingDatePicker" prefWidth="220" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Exit Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="exitTypeCombo" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Notice Period (Days):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="noticeDaysField" promptText="e.g. 30" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Settlement Amount:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="settlementField" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Reason / Remarks:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <TextField fx:id="reasonField" promptText="Higher Studies / Personal" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Clear" styleClass="btn-secondary" onAction="#handleClear"/>
                <Button text="Save Relieving Record" styleClass="btn-primary" onAction="#handleSave"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colDate" text="Relieving Date" prefWidth="110"/>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colDept" text="Department" prefWidth="140"/>
            <TableColumn fx:id="colType" text="Exit Type" prefWidth="120"/>
            <TableColumn fx:id="colReason" text="Reason" prefWidth="200"/>
        </columns>
    </TableView>
</VBox>
