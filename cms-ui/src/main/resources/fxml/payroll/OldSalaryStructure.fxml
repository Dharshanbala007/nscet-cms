<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.OldSalaryStructureController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Historical / Old Salary Structure Archive" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Academic Year:"/>
        <ComboBox fx:id="yearCombo" prefWidth="130"/>
        <Button text="Load Archive" styleClass="btn-primary" onAction="#handleLoad"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colDept" text="Department" prefWidth="140"/>
            <TableColumn fx:id="colOldBasic" text="Historical Basic" prefWidth="120"/>
            <TableColumn fx:id="colOldSpl" text="Historical Special Allw" prefWidth="140"/>
            <TableColumn fx:id="colOldGross" text="Historical Gross" prefWidth="130"/>
            <TableColumn fx:id="colEffective" text="Effective Period" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
