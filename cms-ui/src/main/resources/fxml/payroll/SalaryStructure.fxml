<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.SalaryStructureController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Title matching media_1787900181431.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Salary Structure" styleClass="module-title" minWidth="180"/>
    </HBox>

    <!-- Data Table Grid matching media_1787900181431.png -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colSNo" text="S.No" prefWidth="50"/>
            <TableColumn fx:id="colStaffName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colDesig" text="Designation" prefWidth="150"/>
            <TableColumn fx:id="colDoj" text="DOJ" prefWidth="95"/>
            <TableColumn fx:id="colGrossPay" text="Gross Pay" prefWidth="95"/>
            <TableColumn fx:id="colBasicPay" text="Basic Pay" prefWidth="85"/>
            <TableColumn fx:id="colHra" text="HRA" prefWidth="80"/>
            <TableColumn fx:id="colWashing" text="Washing Allowance" prefWidth="130"/>
            <TableColumn fx:id="colTravelling" text="Travelling Allowance" prefWidth="130"/>
            <TableColumn fx:id="colSpl" text="Spl.Allowance" prefWidth="100"/>
            <TableColumn fx:id="colDiff" text="Diff" prefWidth="55"/>
        </columns>
    </TableView>

    <!-- Bottom Action Buttons Bar matching media_1787900181431.png -->
    <HBox spacing="15" alignment="CENTER">
        <padding><Insets top="8" bottom="8"/></padding>
        <Button text="View" styleClass="btn-primary" minWidth="85" onAction="#handleView"/>
        <Button text="Save" styleClass="btn-secondary" minWidth="85" onAction="#handleSave"/>
    </HBox>
</VBox>
