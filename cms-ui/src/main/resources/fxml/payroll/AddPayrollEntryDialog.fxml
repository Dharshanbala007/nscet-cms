<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.AddPayrollEntryController"
      spacing="14" styleClass="dialog-root" prefWidth="620"
      style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-font-family: 'Segoe UI', sans-serif;">

    <!-- Dialog Header -->
    <VBox spacing="4" style="-fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
        <Label text="Add Staff Payroll Entry" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <Label text="Enter staff salary details and allowances to add to current payroll calculation batch" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
    </VBox>

    <!-- Staff Selection & Basic Info -->
    <TitledPane text="Staff Identification" expanded="true" collapsible="false" style="-fx-font-weight: bold;">
        <GridPane hgap="12" vgap="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="110" prefWidth="120"/>
                <ColumnConstraints minWidth="160" prefWidth="170" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="100" prefWidth="110"/>
                <ColumnConstraints minWidth="160" prefWidth="170" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Select Staff:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: normal;"/>
            <ComboBox fx:id="staffCombo" promptText="-- Select Staff --" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Date of Join:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: normal;"/>
            <DatePicker fx:id="dojPicker" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Staff Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: normal;"/>
            <TextField fx:id="nameField" promptText="Full Name" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Staff Code:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: normal;"/>
            <TextField fx:id="codeField" promptText="e.g. STF001" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Designation:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: normal;"/>
            <TextField fx:id="desigField" promptText="e.g. Assistant Professor" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Department:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: normal;"/>
            <TextField fx:id="deptField" promptText="e.g. CSE / ECE" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>
    </TitledPane>

    <!-- Salary Components Breakdown -->
    <TitledPane text="Earnings &amp; Deductions" expanded="true" collapsible="false" style="-fx-font-weight: bold;">
        <GridPane hgap="12" vgap="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="130"/>
                <ColumnConstraints minWidth="150" prefWidth="160" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="120" prefWidth="130"/>
                <ColumnConstraints minWidth="150" prefWidth="160" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Basic Pay (Rs.):" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: normal;"/>
            <TextField fx:id="basicPayField" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="LOP Days:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: normal;"/>
            <TextField fx:id="lopDaysField" text="0" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="HRA (Rs.):" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: normal;"/>
            <TextField fx:id="hraField" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="LOP Deduct (Rs.):" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: normal;"/>
            <TextField fx:id="lopAmtField" text="0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="SPL Allow. (Rs.):" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: normal;"/>
            <TextField fx:id="splAllowanceField" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Income Tax (Rs.):" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: normal;"/>
            <TextField fx:id="incomeTaxField" text="0" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <Label text="Washing Allow.:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: normal;"/>
            <TextField fx:id="washingField" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="EPF Deduct (Rs.):" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-font-weight: normal;"/>
            <TextField fx:id="epfField" text="0" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

            <Label text="Conveyance:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: normal;"/>
            <TextField fx:id="conveyanceField" text="0" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>
    </TitledPane>

    <!-- Calculation Summary Box -->
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-background-color: #e2e8f0; -fx-padding: 10 15; -fx-background-radius: 6;">
        <Label text="Gross Pay: " style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <Label fx:id="lblGrossPay" text="Rs. 0.00" style="-fx-font-weight: bold; -fx-text-fill: #0284c7; -fx-font-size: 13px;"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Total Deduct: " style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <Label fx:id="lblTotalDeduct" text="Rs. 0.00" style="-fx-font-weight: bold; -fx-text-fill: #dc2626; -fx-font-size: 13px;"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Net Salary: " style="-fx-font-weight: bold; -fx-text-fill: #0f172a; -fx-font-size: 14px;"/>
        <Label fx:id="lblNetPay" text="Rs. 0.00" style="-fx-font-weight: bold; -fx-text-fill: #16a34a; -fx-font-size: 15px;"/>
    </HBox>

    <!-- Buttons -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" prefWidth="90" style="-fx-background-color: #94a3b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button text="Add to Calculation" onAction="#handleAdd" prefWidth="150" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

</VBox>
