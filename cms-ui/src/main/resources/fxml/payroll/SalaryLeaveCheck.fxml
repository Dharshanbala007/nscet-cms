<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.SalaryLeaveCheckController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Title matching media_1787900172047.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Leave Check" styleClass="module-title" minWidth="150"/>
    </HBox>

    <!-- Filter Controls Grid matching legacy screenshot layout -->
    <VBox styleClass="form-container" spacing="10">
        <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>

        <GridPane hgap="15" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="110"/>
                <ColumnConstraints minWidth="180" prefWidth="200"/>
                <ColumnConstraints minWidth="100" prefWidth="110"/>
                <ColumnConstraints minWidth="180" prefWidth="200"/>
                <ColumnConstraints minWidth="80" prefWidth="90"/>
            </columnConstraints>

            <!-- Row 0 -->
            <Label text="From Date:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <DatePicker fx:id="fromDatePicker" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="To Date:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <DatePicker fx:id="toDatePicker" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Row 1 -->
            <Label text="Staff Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="staffNameField" text="KUMARAVEL.P" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Category:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="categoryField" text="NT-Tech" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Row 2 -->
            <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="deptField" text="CSE" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Date of Joining:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <DatePicker fx:id="dojPicker" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <Button text="View" styleClass="btn-primary" minWidth="80" onAction="#handleView" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
        </GridPane>
    </VBox>

    <!-- Side-by-Side Split Tables matching media_1787900172047.png -->
    <HBox spacing="15" VBox.vgrow="ALWAYS">
        <!-- Left Table: Leave Summary Table -->
        <TableView fx:id="summaryTable" HBox.hgrow="ALWAYS" prefWidth="380" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colLeaveType" text="Leave" prefWidth="85"/>
                <TableColumn fx:id="colAvail" text="Available" prefWidth="85"/>
                <TableColumn fx:id="colTaken" text="Taken" prefWidth="85"/>
                <TableColumn fx:id="colBal" text="Balance" prefWidth="85"/>
            </columns>
        </TableView>

        <!-- Right Table: Datewise Leave Detail Breakup Table -->
        <TableView fx:id="detailsTable" HBox.hgrow="ALWAYS" prefWidth="420" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colLeaveDate" text="Leave Date" prefWidth="130"/>
                <TableColumn fx:id="colMorning" text="Morning" prefWidth="110"/>
                <TableColumn fx:id="colAfterNoon" text="After Noon" prefWidth="110"/>
            </columns>
        </TableView>
    </HBox>
</VBox>
