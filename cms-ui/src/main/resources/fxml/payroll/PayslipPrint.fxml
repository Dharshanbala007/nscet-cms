<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.PayslipPrintController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Control Bar -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Payslip Print" styleClass="module-title" minWidth="120"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Employee Name:" minWidth="110"/>
        <ComboBox fx:id="staffCombo" prefWidth="240" minWidth="200"/>
        <Label text="Month:" minWidth="55"/>
        <ComboBox fx:id="monthCombo" prefWidth="120" minWidth="100"/>
        <Button text="View" styleClass="btn-primary" minWidth="75" onAction="#handleGenerate"/>
        <Button text="Print" styleClass="btn-secondary" minWidth="75" onAction="#handlePrint"/>
    </HBox>

    <!-- Payslip View Card matching media_1787897990032.png -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-padding: 0;">
        <VBox alignment="TOP_CENTER" spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 25; -fx-border-color: #334155; -fx-border-width: 1;">
            
            <!-- Header Banner / Title -->
            <HBox alignment="CENTER" spacing="15">
                <VBox alignment="CENTER" spacing="2">
                    <Label text="Nadar Saraswathi College of Engineering and Technology, Vadapudupatti." style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Payslip for the Month of " style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblMonthTitle" text="Jul-26" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #000000;"/>

            <!-- Employee Info Header Grid -->
            <GridPane hgap="25" vgap="8" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="200" prefWidth="240"/>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="200" prefWidth="240"/>
                </columnConstraints>

                <Label text="Employee Name:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblEmpName" text="DR.B.RADHAKRISHNAN" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="UAN No:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label fx:id="lblUanNo" text="100498744032" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Designation:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblDesig" text="H.O.D - MECH" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Date of Joining:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label fx:id="lblDoj" text="1-Mar-2021" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Bank Acc.No:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <Label fx:id="lblBankAcc" text="14620100099406" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            </GridPane>

            <Separator style="-fx-background-color: #000000;"/>

            <!-- Earnings & Deductions Details Grid -->
            <GridPane hgap="40" vgap="6" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints minWidth="130" prefWidth="140"/>
                    <ColumnConstraints minWidth="100" prefWidth="110" alignment="CENTER_RIGHT"/>
                    <ColumnConstraints minWidth="130" prefWidth="140"/>
                    <ColumnConstraints minWidth="40" prefWidth="50" alignment="CENTER"/>
                    <ColumnConstraints minWidth="100" prefWidth="110" alignment="CENTER_RIGHT"/>
                </columnConstraints>

                <!-- Row 1: Basic & EPF -->
                <Label text="Basic Pay:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblBasic" text="15000.00" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="EPF:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label fx:id="lblEpf" text="1800.00" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

                <!-- Row 2: Spl Allowance & ESI -->
                <Label text="Spl.Allowance:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblSpl" text="21000.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="ESI:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label fx:id="lblEsi" text="0.00" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                <!-- Row 3: HRA & LOP -->
                <Label text="HRA:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="lblHra" text="12000.00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Loss of Pay:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <Label fx:id="lblLopDays" text="0" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                <Label fx:id="lblLopAmt" text="0.00" GridPane.columnIndex="4" GridPane.rowIndex="2"/>

                <!-- Row 4: Conveyance & IT -->
                <Label text="Conveyance:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label fx:id="lblConveyance" text="6000.00" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Income Tax:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <Label fx:id="lblIncomeTax" text="0.00" GridPane.columnIndex="4" GridPane.rowIndex="3"/>

                <!-- Row 5: Wash Allowance & Staff Club -->
                <Label text="Wash.Allowance:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Label fx:id="lblWashing" text="6000.00" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Staff Club:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <Label text="Rs." GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                <Label fx:id="lblStaffClub" text="200.00" GridPane.columnIndex="4" GridPane.rowIndex="4"/>

                <!-- Row 6: Professional Tax -->
                <Label text="Professional Tax:" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                <Label text="Rs." GridPane.columnIndex="3" GridPane.rowIndex="5"/>
                <Label fx:id="lblProfTax" text="0.00" GridPane.columnIndex="4" GridPane.rowIndex="5"/>

                <!-- Row 7: Others -->
                <Label text="Others :" GridPane.columnIndex="2" GridPane.rowIndex="6"/>
                <Label text="Rs." GridPane.columnIndex="3" GridPane.rowIndex="6"/>
                <Label fx:id="lblOthers" text="0.00" GridPane.columnIndex="4" GridPane.rowIndex="6"/>

                <!-- Row 8: Gross Pay & Total Deductions -->
                <Label text="Gross Pay:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <Label fx:id="lblGrossPay" text="60000.00" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label text="Deduction Total:" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="7"/>
                <Label fx:id="lblTotalDeduction" text="2000.00" style="-fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="7"/>
            </GridPane>

            <!-- Net Pay & Words Summary Box -->
            <VBox alignment="CENTER_RIGHT" spacing="6" style="-fx-padding: 15 20 5 20;">
                <HBox alignment="CENTER_RIGHT" spacing="40">
                    <Label text="Net Pay:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label fx:id="lblNetPay" text="58000.00" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                </HBox>

                <Label fx:id="lblInWords" text="Rupees - Fifty-Eight Thousand Only" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>

                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                    <Label text="Signature" style="-fx-font-weight: bold;"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
