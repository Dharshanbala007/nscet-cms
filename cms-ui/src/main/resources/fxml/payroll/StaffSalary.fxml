<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.StaffSalaryController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Title matching media_1787900594170.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Staff Details" styleClass="module-title" minWidth="150"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search staff..." styleClass="search-field" prefWidth="200"/>
        <Button text="Find Staff" styleClass="btn-primary" minWidth="90" onAction="#handleSearch"/>
    </HBox>

    <!-- Staff Details Form Card matching media_1787900594170.png -->
    <VBox styleClass="form-container" spacing="12">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

        <GridPane hgap="20" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="130"/>
                <ColumnConstraints minWidth="180" prefWidth="220"/>
                <ColumnConstraints minWidth="120" prefWidth="130"/>
                <ColumnConstraints minWidth="180" prefWidth="220"/>
            </columnConstraints>

            <!-- Row 0 -->
            <Label text="Staff Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="staffNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Category:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="categoryField" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Row 1 -->
            <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="deptField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="CL Balance:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="clBalField" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Row 2 -->
            <Label text="Total LOP:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="totalLopField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Bank Name:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <ComboBox fx:id="bankNameCombo" prefWidth="220" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <!-- Row 3 -->
            <Label text="A/C No:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="accNoField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="PF A/C No:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <TextField fx:id="pfAccNoField" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

            <!-- Row 4 -->
            <Label text="Basic Pay:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="basicPayField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="HRA:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
            <TextField fx:id="hraField" GridPane.columnIndex="3" GridPane.rowIndex="4"/>

            <!-- Row 5 -->
            <Label text="Special Allowance:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="splAllowanceField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Wash.Allowance:" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
            <TextField fx:id="washAllowanceField" GridPane.columnIndex="3" GridPane.rowIndex="5"/>

            <!-- Row 6 -->
            <Label text="TA Type:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <ComboBox fx:id="taTypeCombo" prefWidth="220" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

            <Label text="Conveyance:" GridPane.columnIndex="2" GridPane.rowIndex="6"/>
            <TextField fx:id="conveyanceField" GridPane.columnIndex="3" GridPane.rowIndex="6"/>

            <!-- Row 7 -->
            <Label text="TA Per Day:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <TextField fx:id="taPerDayField" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

            <Label text="TA Per Month:" GridPane.columnIndex="2" GridPane.rowIndex="7"/>
            <TextField fx:id="taPerMonthField" GridPane.columnIndex="3" GridPane.rowIndex="7"/>

            <!-- Row 8 -->
            <Label text="ISTE:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
            <TextField fx:id="isteField" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

            <Label text="Income Tax:" GridPane.columnIndex="2" GridPane.rowIndex="8"/>
            <TextField fx:id="incomeTaxField" GridPane.columnIndex="3" GridPane.rowIndex="8"/>

            <!-- Row 9 -->
            <Label text="EPF ABRY:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
            <ComboBox fx:id="epfAbryCombo" prefWidth="220" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

            <Label text="Caste Category:" GridPane.columnIndex="2" GridPane.rowIndex="9"/>
            <ComboBox fx:id="casteCategoryCombo" prefWidth="220" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="9"/>

            <!-- Row 10 -->
            <Label text="ESI Allowed:" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
            <HBox spacing="15" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="10">
                <RadioButton fx:id="esiYesRadio" text="Yes"/>
                <RadioButton fx:id="esiNoRadio" text="No" selected="true"/>
            </HBox>

            <Label text="Professional Tax:" GridPane.columnIndex="2" GridPane.rowIndex="10"/>
            <TextField fx:id="profTaxField" GridPane.columnIndex="3" GridPane.rowIndex="10"/>
        </GridPane>

        <Separator/>

        <!-- Action Button Bar: Add, Modify, Delete, Save, Cancel, Close -->
        <HBox spacing="8" alignment="CENTER">
            <Button text="Add" styleClass="btn-secondary" minWidth="65" onAction="#handleAdd"/>
            <Button text="Modify" styleClass="btn-secondary" minWidth="65" onAction="#handleModify"/>
            <Button text="Delete" styleClass="btn-danger" minWidth="65" onAction="#handleDelete"/>
            <Button text="Save" styleClass="btn-primary" minWidth="65" onAction="#handleSave"/>
            <Button text="Cancel" styleClass="btn-secondary" minWidth="65" onAction="#handleCancel"/>
            <Button text="Close" styleClass="btn-secondary" minWidth="65" onAction="#handleClose"/>
        </HBox>
    </VBox>

    <!-- Data Table View (Find Staff List) matching media_1787900602512.png -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table" minHeight="200">
        <columns>
            <TableColumn fx:id="colStaffName" text="Staffname" prefWidth="180"/>
            <TableColumn fx:id="colCategory" text="Category" prefWidth="100"/>
            <TableColumn fx:id="colDept" text="Department" prefWidth="110"/>
            <TableColumn fx:id="colClBal" text="CL Balance" prefWidth="90"/>
            <TableColumn fx:id="colBankName" text="Bank Name" prefWidth="90"/>
            <TableColumn fx:id="colBankAcc" text="Bank Acc.No" prefWidth="140"/>
            <TableColumn fx:id="colPfNo" text="PF No" prefWidth="120"/>
            <TableColumn fx:id="colBasic" text="Basic" prefWidth="90"/>
        </columns>
    </TableView>
</VBox>
