<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.LeaveMasterController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Title matching media_1787900542316.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Leave Master" styleClass="module-title" minWidth="150"/>
    </HBox>

    <!-- Top Form Card matching media_1787900542316.png -->
    <VBox styleClass="form-container" spacing="12" maxWidth="500" alignment="CENTER_LEFT">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="130"/>
                <ColumnConstraints minWidth="220" prefWidth="250"/>
            </columnConstraints>

            <Label text="Leave Code:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="codeField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Leave Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Leave Sh.Name:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="shortNameField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <Separator/>

        <!-- Action Button Bar: Add, Modify, Delete, Save, Cancel, Close -->
        <HBox spacing="8" alignment="CENTER">
            <Button text="Add" styleClass="btn-secondary" minWidth="65" onAction="#handleAdd"/>
            <Button text="Modify" styleClass="btn-secondary" minWidth="65" onAction="#handleModify"/>
            <Button text="Delete" styleClass="btn-danger" minWidth="65" onAction="#handleDelete"/>
            <Button text="Save" styleClass="btn-primary" minWidth="65" onAction="#handleSave"/>
            <Button text="Cancel" styleClass="btn-secondary" minWidth="65" onAction="#handleCancel"/>
            <Button text="Close" styleClass="btn-secondary" minWidth="65" onAction="#handleClose"/>
        </HBox>
    </VBox>

    <!-- Data Table View for Leave Master -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colSlNo" text="S.No" prefWidth="55"/>
            <TableColumn fx:id="colCode" text="Leave Code" prefWidth="120"/>
            <TableColumn fx:id="colName" text="Leave Name" prefWidth="220"/>
            <TableColumn fx:id="colShortName" text="Leave Sh.Name" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
