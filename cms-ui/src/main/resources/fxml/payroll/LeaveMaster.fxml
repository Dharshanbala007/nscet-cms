<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.LeaveMasterController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Leave Master Setup" styleClass="module-title"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="250" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colSlNo" text="S.No" prefWidth="60"/>
            <TableColumn fx:id="colCode" text="Leave Code" prefWidth="120"/>
            <TableColumn fx:id="colName" text="Leave Name" prefWidth="220"/>
            <TableColumn fx:id="colShortName" text="Short Name" prefWidth="120"/>
            <TableColumn fx:id="colMaxAllowed" text="Max Allowed (Days)" prefWidth="150"/>
        </columns>
    </TableView>

    <TitledPane text="Leave Entry / Setup" expanded="true">
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <GridPane hgap="15" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="200" prefWidth="220"/>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="200" prefWidth="220"/>
                </columnConstraints>

                <Label text="Leave Code:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="codeField" promptText="e.g. CL" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Leave Name:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="nameField" promptText="e.g. Casual Leave" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Short Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="shortNameField" promptText="e.g. CL" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Max Allowed (Days):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="maxAllowedField" promptText="12" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Clear" styleClass="btn-secondary" onAction="#handleClear"/>
                <Button text="Save Leave" styleClass="btn-primary" onAction="#handleSave"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
