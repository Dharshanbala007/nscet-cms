<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.StaffClubController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Staff Club Details" styleClass="module-title" minWidth="200"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" styleClass="btn-primary" minWidth="80" onAction="#handleRefresh"/>
        <Button text="Save" styleClass="btn-success" minWidth="80" onAction="#handleSave"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colSlNo" text="Sl.No" prefWidth="55"/>
            <TableColumn fx:id="colStaffCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colStaffName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="140"/>
            <TableColumn fx:id="colDesignation" text="Designation" prefWidth="140"/>
            <TableColumn fx:id="colStaffClub" text="Staff Club (₹)" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
