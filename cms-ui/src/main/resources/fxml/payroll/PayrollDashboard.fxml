<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.PayrollDashboardController"
      styleClass="master-container" spacing="15">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Payroll Dashboard &amp; Summary" styleClass="module-title"/>
    </HBox>

    <!-- Summary Cards Bar -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <VBox spacing="4" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Active Staff Count" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
            <Label fx:id="totalStaffLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </VBox>
        <VBox spacing="4" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Monthly Gross Payroll" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
            <Label fx:id="grossPayrollLabel" text="₹0.00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
        </VBox>
        <VBox spacing="4" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Total Monthly Deductions" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
            <Label fx:id="deductionsLabel" text="₹0.00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
        </VBox>
        <VBox spacing="4" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Net Payable Salary" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
            <Label fx:id="netPayrollLabel" text="₹0.00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
        </VBox>
    </HBox>

    <!-- Recent Staff Payroll Overview Table -->
    <VBox VBox.vgrow="ALWAYS" spacing="10">
        <Label text="Staff Payroll Overview" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
                <TableColumn fx:id="colName" text="Staff Name" prefWidth="180"/>
                <TableColumn fx:id="colDept" text="Department" prefWidth="140"/>
                <TableColumn fx:id="colDesig" text="Designation" prefWidth="150"/>
                <TableColumn fx:id="colBasic" text="Basic Pay" prefWidth="110"/>
                <TableColumn fx:id="colGross" text="Gross Salary" prefWidth="120"/>
                <TableColumn fx:id="colDeductions" text="Deductions" prefWidth="110"/>
                <TableColumn fx:id="colNet" text="Net Salary" prefWidth="120"/>
                <TableColumn fx:id="colBank" text="Bank Acc No" prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
