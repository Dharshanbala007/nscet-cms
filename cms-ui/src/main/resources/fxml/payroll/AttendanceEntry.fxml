<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.AttendanceEntryController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Daily Staff Attendance Logging" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Attendance Date:"/>
        <DatePicker fx:id="datePicker" prefWidth="140"/>
        <Label text="Session:"/>
        <ComboBox fx:id="sessionCombo" prefWidth="130"/>
        <Button text="Load Staff" styleClass="btn-secondary" onAction="#handleLoadStaff"/>
        <Button text="Save Attendance" styleClass="btn-primary" onAction="#handleSaveAll"/>
    </HBox>

    <!-- Attendance Table -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="200"/>
            <TableColumn fx:id="colDept" text="Department" prefWidth="150"/>
            <TableColumn fx:id="colDesig" text="Designation" prefWidth="160"/>
            <TableColumn fx:id="colStatus" text="Attendance Status" prefWidth="160"/>
            <TableColumn fx:id="colRemarks" text="Remarks / Notes" prefWidth="250"/>
        </columns>
    </TableView>
</VBox>
