<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.AttendanceSingleController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Attendance Single Entry" styleClass="module-title"/>
    </HBox>

    <TitledPane text="Attendance Single Entry Details" expanded="true">
        <VBox spacing="12">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>

            <GridPane hgap="15" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="240" prefWidth="260"/>
                </columnConstraints>

                <!-- Date -->
                <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <DatePicker fx:id="datePicker" prefWidth="260" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <!-- Staff Name -->
                <Label text="Staff Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="staffCombo" prefWidth="260" promptText="Select Staff..." GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <!-- Category -->
                <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="categoryField" promptText="Category" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <!-- Department -->
                <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="departmentField" promptText="Department" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <!-- Session -->
                <Label text="Session:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="sessionCombo" prefWidth="260" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <!-- Attendance Type -->
                <Label text="Attendance Type:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ComboBox fx:id="typeCombo" prefWidth="260" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <!-- Bottom Action Buttons matching screenshot template -->
            <HBox spacing="8" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button text="Add" minWidth="80" styleClass="btn-secondary" onAction="#handleAdd"/>
                <Button text="Modify" minWidth="80" styleClass="btn-secondary" onAction="#handleModify"/>
                <Button text="Delete" minWidth="80" styleClass="btn-danger" onAction="#handleDelete"/>
                <Button text="Save" minWidth="80" styleClass="btn-primary" onAction="#handleSave"/>
                <Button text="Cancel" minWidth="80" styleClass="btn-secondary" onAction="#handleCancel"/>
                <Button text="Close" minWidth="80" styleClass="btn-secondary" onAction="#handleClose"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- Table View -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="220" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="200"/>
            <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
            <TableColumn fx:id="colDept" text="Department" prefWidth="140"/>
            <TableColumn fx:id="colSession" text="Session" prefWidth="120"/>
            <TableColumn fx:id="colType" text="Attendance Type" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
