<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.FullLeaveDetailsController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls matching media_1787899659739.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Staff Leave Details" styleClass="module-title" minWidth="150"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="From Date:" minWidth="75"/>
        <DatePicker fx:id="fromDate" prefWidth="130" minWidth="120"/>
        <Label text="To Date:" minWidth="65"/>
        <DatePicker fx:id="toDate" prefWidth="130" minWidth="120"/>
        <Button text="View" styleClass="btn-primary" minWidth="75" onAction="#handleView"/>
        <Button text="Print" styleClass="btn-secondary" minWidth="75" onAction="#handlePrint"/>
    </HBox>

    <!-- 15-Column Data Matrix Table matching media_1787899659739.png -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colSlNo" text="Sl.No" prefWidth="50"/>
            <TableColumn fx:id="colStaffName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colDoj" text="Date of Joining" prefWidth="110"/>
            <TableColumn fx:id="colClAllowed" text="Cl Allowed" prefWidth="80"/>
            <TableColumn fx:id="colCL" text="CL" prefWidth="50"/>
            <TableColumn fx:id="colLOP" text="LOP" prefWidth="50"/>
            <TableColumn fx:id="colAB" text="AB" prefWidth="45"/>
            <TableColumn fx:id="colSpl" text="Spl" prefWidth="45"/>
            <TableColumn fx:id="colOdExam" text="OD Exam" prefWidth="75"/>
            <TableColumn fx:id="colVL" text="VL" prefWidth="45"/>
            <TableColumn fx:id="colComp" text="Comp" prefWidth="50"/>
            <TableColumn fx:id="colML" text="ML" prefWidth="45"/>
            <TableColumn fx:id="colOdFdp" text="OD FDP" prefWidth="65"/>
            <TableColumn fx:id="colOdAdmis" text="OD Admis" prefWidth="75"/>
            <TableColumn fx:id="colOdOther" text="OD O" prefWidth="55"/>
        </columns>
    </TableView>
</VBox>
