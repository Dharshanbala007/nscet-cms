<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.PfEsiToolsController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="PF &amp; ESI Statutory Returns &amp; ECR Generation Tool" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Return Month:"/>
        <ComboBox fx:id="monthCombo" prefWidth="130"/>
        <Button text="Generate PF/ESI Returns" styleClass="btn-primary" onAction="#handleGenerate"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colBasic" text="Wages for PF" prefWidth="120"/>
            <TableColumn fx:id="colEpfEmp" text="EPF (Emp Share)" prefWidth="130"/>
            <TableColumn fx:id="colEpfComp" text="EPF (Employer Share)" prefWidth="150"/>
            <TableColumn fx:id="colEsiEmp" text="ESI (Emp Share)" prefWidth="130"/>
            <TableColumn fx:id="colEsiComp" text="ESI (Employer Share)" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
