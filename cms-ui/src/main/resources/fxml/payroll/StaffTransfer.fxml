<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.StaffTransferController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Staff Department &amp; Designation Transfer" styleClass="module-title"/>
    </HBox>

    <TitledPane text="Staff Transfer Details" expanded="true">
        <VBox spacing="12">
            <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>

            <GridPane hgap="15" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="220" prefWidth="240"/>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="220" prefWidth="240"/>
                </columnConstraints>

                <Label text="Staff Member:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="staffCombo" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Transfer Date:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <DatePicker fx:id="transferDatePicker" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Current Dept:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="currentDeptField" editable="false" style="-fx-background-color: #f1f5f9;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="New Department:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <ComboBox fx:id="newDeptCombo" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Current Designation:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="currentDesigField" editable="false" style="-fx-background-color: #f1f5f9;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="New Designation:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <TextField fx:id="newDesigField" promptText="Enter new designation..." GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <Label text="Transfer Order No:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="orderNoField" promptText="Order Ref No..." GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Remarks:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <TextField fx:id="remarksField" promptText="Internal Transfer / Promotion" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                <Button text="Clear" styleClass="btn-secondary" minWidth="80" onAction="#handleClear"/>
                <Button text="Save Transfer" styleClass="btn-primary" minWidth="110" onAction="#handleSave"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- Transfer Log Table -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colFromDept" text="From Dept" prefWidth="130"/>
            <TableColumn fx:id="colToDept" text="To Dept" prefWidth="130"/>
            <TableColumn fx:id="colNewDesig" text="New Designation" prefWidth="150"/>
            <TableColumn fx:id="colOrderNo" text="Order No" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
