<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.PayrollCalculationController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header & Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Monthly Payroll Calculation Engine" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Pay Period:"/>
        <ComboBox fx:id="payPeriodCombo" prefWidth="130"/>
        <Label text="Working Days:"/>
        <TextField fx:id="workingDaysField" text="30" prefWidth="60"/>
        <Button text="Run Payroll Engine" styleClass="btn-primary" onAction="#handleCalculate"/>
    </HBox>

    <!-- Summary Metrics -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label fx:id="periodSummaryLabel" text="Selected Period: Jul-2026" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1e293b;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalNetLabel" text="Total Net Salary: ₹0.00" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #10b981;"/>
    </HBox>

    <!-- Calculation Results Table -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="90"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colDept" text="Department" prefWidth="130"/>
            <TableColumn fx:id="colWorkingDays" text="Working Days" prefWidth="95"/>
            <TableColumn fx:id="colPaidDays" text="Paid Days" prefWidth="85"/>
            <TableColumn fx:id="colLopDays" text="LOP Days" prefWidth="80"/>
            <TableColumn fx:id="colBasic" text="Basic Pay" prefWidth="100"/>
            <TableColumn fx:id="colSpl" text="Special Allw" prefWidth="100"/>
            <TableColumn fx:id="colGross" text="Gross Pay" prefWidth="110"/>
            <TableColumn fx:id="colDeductions" text="Deductions" prefWidth="100"/>
            <TableColumn fx:id="colNet" text="Net Pay" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
