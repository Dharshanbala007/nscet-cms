<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.MonthlyLeaveCreditController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls matching media_1787900137431.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Monthly Leave Credit" styleClass="module-title" minWidth="180"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="From Date:" minWidth="75"/>
        <DatePicker fx:id="fromDate" prefWidth="130" minWidth="120"/>
        <Label text="To Date:" minWidth="65"/>
        <DatePicker fx:id="toDate" prefWidth="130" minWidth="120"/>
        <Button text="View" styleClass="btn-primary" minWidth="75" onAction="#handleView"/>
        <Button text="Save" styleClass="btn-secondary" minWidth="75" onAction="#handleSave"/>
    </HBox>

    <!-- Data Table matching media_1787900137431.png -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colSlNo" text="Sl.No" prefWidth="55"/>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="220"/>
            <TableColumn fx:id="colLeaveBal" text="Leave Balance" prefWidth="120"/>
            <TableColumn fx:id="colLeaveCredit" text="Leave Credit" prefWidth="110"/>
            <TableColumn fx:id="colAvailable" text="Available" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
