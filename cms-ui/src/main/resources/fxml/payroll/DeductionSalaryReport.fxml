<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.DeductionSalaryReportController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls matching media_1787900145839.png & media_1787900151669.png -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="Deduction Salary Details" styleClass="module-title" minWidth="200"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="From Date:" minWidth="75"/>
        <DatePicker fx:id="fromDate" prefWidth="130" minWidth="120"/>
        <Label text="To Date:" minWidth="65"/>
        <DatePicker fx:id="toDate" prefWidth="130" minWidth="120"/>
        <Button text="View" styleClass="btn-primary" minWidth="75" onAction="#handleLoad"/>
        <Button text="Print" styleClass="btn-secondary" minWidth="75" onAction="#handlePrint"/>
        <ComboBox fx:id="yearCombo" prefWidth="110" minWidth="100" promptText="Select"/>
    </HBox>

    <!-- Data Table matching media_1787900151669.png -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colSlNo" text="Sl.No" prefWidth="50"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="170"/>
            <TableColumn fx:id="colDesig" text="Designation" prefWidth="140"/>
            <TableColumn fx:id="colDoj" text="DOJ" prefWidth="90"/>
            <TableColumn fx:id="colJun" text="June 2021" prefWidth="75"/>
            <TableColumn fx:id="colJul" text="July 2021" prefWidth="75"/>
            <TableColumn fx:id="colAug" text="Aug 2021" prefWidth="75"/>
            <TableColumn fx:id="colSep" text="Sep 2021" prefWidth="75"/>
            <TableColumn fx:id="colOct" text="Oct 2021" prefWidth="75"/>
            <TableColumn fx:id="colNov" text="Nov 2021" prefWidth="75"/>
            <TableColumn fx:id="colDec" text="Dec 2021" prefWidth="75"/>
            <TableColumn fx:id="colJan" text="Jan 2022" prefWidth="75"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>
