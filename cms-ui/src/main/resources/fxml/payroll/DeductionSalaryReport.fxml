<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.DeductionSalaryReportController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Monthly Deduction Salary Matrix (Academic Year)" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Academic Year:"/>
        <ComboBox fx:id="yearCombo" prefWidth="130"/>
        <Button text="Load Deduction Matrix" styleClass="btn-primary" onAction="#handleLoad"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="160"/>
            <TableColumn fx:id="colDesig" text="Designation" prefWidth="140"/>
            <TableColumn fx:id="colDept" text="Department" prefWidth="120"/>
            <TableColumn fx:id="colJun" text="Jun" prefWidth="65"/>
            <TableColumn fx:id="colJul" text="Jul" prefWidth="65"/>
            <TableColumn fx:id="colAug" text="Aug" prefWidth="65"/>
            <TableColumn fx:id="colSep" text="Sep" prefWidth="65"/>
            <TableColumn fx:id="colOct" text="Oct" prefWidth="65"/>
            <TableColumn fx:id="colNov" text="Nov" prefWidth="65"/>
            <TableColumn fx:id="colDec" text="Dec" prefWidth="65"/>
            <TableColumn fx:id="colJan" text="Jan" prefWidth="65"/>
            <TableColumn fx:id="colFeb" text="Feb" prefWidth="65"/>
            <TableColumn fx:id="colMar" text="Mar" prefWidth="65"/>
            <TableColumn fx:id="colApr" text="Apr" prefWidth="65"/>
            <TableColumn fx:id="colMay" text="May" prefWidth="65"/>
            <TableColumn fx:id="colTotal" text="Total LOP Deduction" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
