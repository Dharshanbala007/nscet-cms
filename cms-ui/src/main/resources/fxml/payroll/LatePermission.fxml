<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.payroll.LatePermissionController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Controls -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Late / Permission Details Logging" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Add" styleClass="btn-secondary" minWidth="80" onAction="#handleAdd"/>
        <Button text="Delete" styleClass="btn-danger" minWidth="80" onAction="#handleDelete"/>
    </HBox>

    <TitledPane text="Permission Entry" expanded="true">
        <VBox spacing="10">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>

            <GridPane hgap="15" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="200" prefWidth="220"/>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints minWidth="200" prefWidth="220"/>
                </columnConstraints>

                <Label text="Staff Member:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="staffCombo" prefWidth="220" editable="true" promptText="Select or type (Code - Name)" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <DatePicker fx:id="datePicker" prefWidth="220" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="typeCombo" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Duration (Mins):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="durationField" promptText="e.g. 60" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Reason / Remarks:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="reasonField" promptText="Personal / Official" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Clear" styleClass="btn-secondary" onAction="#handleClear"/>
                <Button text="Save Record" styleClass="btn-primary" onAction="#handleSave"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colCode" text="Staff Code" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Staff Name" prefWidth="180"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
            <TableColumn fx:id="colDuration" text="Duration" prefWidth="100"/>
            <TableColumn fx:id="colReason" text="Reason" prefWidth="220"/>
        </columns>
    </TableView>
</VBox>
