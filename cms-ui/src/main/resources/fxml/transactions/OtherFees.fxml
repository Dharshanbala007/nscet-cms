<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.OtherFeesController"
      styleClass="master-container" spacing="12">

    <!-- Header -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
        <Label text="Others Fees Details" styleClass="module-title"/>
    </HBox>

    <VBox spacing="15" VBox.vgrow="ALWAYS">
        <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>

        <!-- Form Controls -->
        <VBox styleClass="form-container" spacing="10">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="180" prefWidth="220" hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="100" prefWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="180" prefWidth="220" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Row 0: From Date & To Date -->
                <Label text="From Date:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <DatePicker fx:id="fromDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>

                <Label text="To Date:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <DatePicker fx:id="toDatePicker" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>

                <!-- Row 1: Degree & Fees -->
                <Label text="Degree:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="degreeCombo" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"/>

                <Label text="Fees:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <ComboBox fx:id="feesNameCombo" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"/>

                <!-- Row 2: Semester & Admission Type -->
                <Label text="Semester:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="semCombo" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"/>

                <Label text="Admission Type:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <ComboBox fx:id="admissionTypeCombo" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"/>

                <!-- Row 3: Quota & Dept -->
                <Label text="Quota:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="quotaCombo" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"/>

                <Label text="Dept:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <ComboBox fx:id="deptCombo" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"/>

                <!-- Row 4: State & Amount -->
                <Label text="State:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="stateCombo" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308"/>

                <Label text="Amount:" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 11.5px;" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <TextField fx:id="amountField" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
            </GridPane>

            <!-- Action Button Bar -->
            <HBox spacing="10" alignment="CENTER">
                <padding><Insets top="10" bottom="5"/></padding>
                <Button text="Add" styleClass="btn-secondary" prefWidth="80" onAction="#handleAdd"/>
                <Button text="Modify" styleClass="btn-secondary" prefWidth="80" onAction="#handleModify"/>
                <Button text="Delete" styleClass="btn-danger" prefWidth="80" onAction="#handleDelete"/>
                <Button text="Save" styleClass="btn-primary" prefWidth="80" onAction="#handleSave"/>
                <Button text="Cancel" styleClass="btn-secondary" prefWidth="80" onAction="#handleCancel"/>
                <Button text="Close" styleClass="btn-secondary" prefWidth="80" onAction="#handleClose"/>
            </HBox>
        </VBox>

        <!-- Table View -->
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="slNoCol" text="Sl No" prefWidth="60"/>
                <TableColumn fx:id="degreeCol" text="Degree" prefWidth="100"/>
                <TableColumn fx:id="deptCol" text="Dept" prefWidth="120"/>
                <TableColumn fx:id="semCol" text="Semester" prefWidth="90"/>
                <TableColumn fx:id="feesNameCol" text="Fees Name" prefWidth="200"/>
                <TableColumn fx:id="amountCol" text="Amount" prefWidth="130"/>
                <TableColumn fx:id="fromDateCol" text="From Date" prefWidth="110"/>
                <TableColumn fx:id="toDateCol" text="To Date" prefWidth="110"/>
            </columns>
        </TableView>

        <!-- Total Row -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label text="Total:" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>
            <TextField fx:id="totalField" editable="false" prefWidth="180" style="-fx-font-weight: bold; -fx-alignment: CENTER-RIGHT;"/>
        </HBox>
    </VBox>
</VBox>
