<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.FeeCollectionController"
      styleClass="master-container" spacing="8" style="-fx-background-color: #e2e8f0; -fx-padding: 10;">

    <!-- Top Header Bar -->
    <HBox style="-fx-background-color: #ffffff; -fx-padding: 8 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" alignment="CENTER_LEFT" spacing="15">
        <Label text="Nadar Saraswathi College of Engineering and Technology, Theni" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #0f172a;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10" alignment="CENTER">
            <RadioButton fx:id="currentRadio" text="Current" selected="true"/>
            <RadioButton fx:id="passedOutRadio" text="Passed Out"/>
            <RadioButton fx:id="staffRadio" text="Staff"/>
            <RadioButton fx:id="miscRadio" text="Misc"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Find Student" styleClass="btn-primary" onAction="#handleStudentSearch"/>
        <Button text="Exit" styleClass="btn-secondary" onAction="#handleClear"/>
    </HBox>

    <!-- Top Control Bar -->
    <HBox style="-fx-background-color: #ffffff; -fx-padding: 6 15; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" alignment="CENTER_LEFT" spacing="15">
        <Label text="Receipt Date:"/>
        <DatePicker fx:id="receiptDatePicker" prefWidth="130"/>
        <Label text="Pending Fees:"/>
        <TextField fx:id="pendingFeesTotalField" editable="false" prefWidth="100" text="0" style="-fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Bank A/C:"/>
        <ComboBox fx:id="baseAccountCombo" prefWidth="140"/>
        <Label text="Pay Type:"/>
        <ComboBox fx:id="payTypeCombo" prefWidth="140"/>
    </HBox>

    <!-- Main 3-Column Layout -->
    <HBox spacing="10" VBox.vgrow="ALWAYS">

        <!-- COLUMN 1: LEFT PANEL (Student Info, Particulars Table, Semester Grid) -->
        <VBox spacing="8" prefWidth="380" style="-fx-background-color: #ffffff; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
            <GridPane hgap="8" vgap="4">
                <columnConstraints>
                    <ColumnConstraints minWidth="80" prefWidth="85"/>
                    <ColumnConstraints minWidth="100" prefWidth="110"/>
                    <ColumnConstraints minWidth="75" prefWidth="80"/>
                    <ColumnConstraints minWidth="90" prefWidth="100"/>
                </columnConstraints>
                <Label text="Receipt Type:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="receiptTypeCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="110"/>
                <Label text="Period:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="periodField" text="2025-26" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Receipt No:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="receiptNoField" text="22920" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Degree:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="degreeField" text="B.E" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Student Name:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="studentNameField" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3"/>

                <Label text="Roll No / Search:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="studentSearchField" promptText="Enter Roll No" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Dept:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <TextField fx:id="deptField" text="CSE" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                <Label text="Reg No:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="regNoField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Semester:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <TextField fx:id="semField" text="3" GridPane.columnIndex="3" GridPane.rowIndex="4"/>

                <Label text="Caste:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="casteField" text="BC" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                <Label text="Ad. Type:" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                <TextField fx:id="adNoField" text="Fresh" GridPane.columnIndex="3" GridPane.rowIndex="5"/>
            </GridPane>

            <!-- Fee Particulars Table -->
            <Label text="Fee Particulars Structure:" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
            <TableView fx:id="particularsTable" prefHeight="170" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="partNameCol" text="Particulars" prefWidth="180"/>
                    <TableColumn fx:id="partAmountCol" text="Amount" prefWidth="85"/>
                    <TableColumn fx:id="partPaidCol" text="Paid" prefWidth="85"/>
                </columns>
            </TableView>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Total Structure:" style="-fx-font-size: 11px;"/>
                <TextField fx:id="totalStructAmtField" text="69540" editable="false" prefWidth="85"/>
                <TextField fx:id="totalStructPaidField" text="11500" editable="false" prefWidth="85"/>
            </HBox>

            <!-- Bottom Left Semester Grid (1 to 8) -->
            <VBox spacing="4" style="-fx-background-color: #f8fafc; -fx-padding: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Semester History:" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="01/08/2025" style="-fx-font-size: 10px;"/>
                    <Label text="01/01/2026" style="-fx-font-size: 10px;"/>
                    <Label text="01/06/2026" style="-fx-font-size: 10px;"/>
                </HBox>
                <!-- Grid of 8 Semester Buttons -->
                <GridPane hgap="6" vgap="6">
                    <Button fx:id="btnSem1" text="1" onAction="#handleSem1" prefWidth="80" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Button fx:id="btnSem2" text="2" onAction="#handleSem2" prefWidth="80" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button fx:id="btnSem3" text="3" onAction="#handleSem3" prefWidth="80" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Button fx:id="btnSem4" text="4" onAction="#handleSem4" prefWidth="80" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Button fx:id="btnSem5" text="5" onAction="#handleSem5" prefWidth="80" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Button fx:id="btnSem6" text="6" onAction="#handleSem6" prefWidth="80" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Button fx:id="btnSem7" text="7" onAction="#handleSem7" prefWidth="80" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Button fx:id="btnSem8" text="8" onAction="#handleSem8" prefWidth="80" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                </GridPane>
            </VBox>
        </VBox>

        <!-- COLUMN 2: MIDDLE PANEL (Pending Particulars Table) -->
        <VBox spacing="8" prefWidth="350" style="-fx-background-color: #ffffff; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
            <Label text="Pending Semester Particulars:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
            <TableView fx:id="pendingParticularsTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="pendSemCol" text="Sem" prefWidth="45"/>
                    <TableColumn fx:id="pendNameCol" text="Particulars" prefWidth="150"/>
                    <TableColumn fx:id="pendAmtCol" text="Pending Amt" prefWidth="90"/>
                    <TableColumn fx:id="pendGroupCol" text="Group" prefWidth="50"/>
                </columns>
            </TableView>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Total Pending Balance:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="totalPendingAmtField" text="59840" editable="false" prefWidth="110" style="-fx-font-weight: bold; -fx-text-fill: #b91c1c;"/>
            </HBox>
        </VBox>

        <!-- COLUMN 3: RIGHT PANEL (Payment Allocation & Receipt Actions) -->
        <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
            <Label text="Payment Allocation &amp; Payment Input:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>

            <Label text="Remarks:"/>
            <TextArea fx:id="remarksArea" prefHeight="50" promptText="Enter payment remarks / UPI / DD details..."/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Fees Name:"/>
                <ComboBox fx:id="feeNameCombo" prefWidth="140"/>
                <Label text="Amount:"/>
                <TextField fx:id="amountField" promptText="Enter amount" prefWidth="110"/>
                <Button text="Auto-Allocate" styleClass="btn-primary" onAction="#handleAutoAllocate"/>
                <Button text="Add Fee" styleClass="btn-secondary" onAction="#handleManualAdd"/>
            </HBox>

            <!-- Allocation Table -->
            <TableView fx:id="itemsTable" prefHeight="160" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="allocSemCol" text="Sem" prefWidth="45"/>
                    <TableColumn fx:id="feeNameCol" text="Particulars" prefWidth="160"/>
                    <TableColumn fx:id="feeAmtCol" text="Amount" prefWidth="90"/>
                    <TableColumn fx:id="allocCol" text="Allocated To" prefWidth="120"/>
                </columns>
            </TableView>

            <GridPane hgap="10" vgap="6">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="140"/>
                    <ColumnConstraints minWidth="150" prefWidth="180"/>
                </columnConstraints>
                <Label text="Receipt Total:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="runningTotalLabelField" text="₹0.00" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Amount Paid (Cash/Bank):" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="amountPaidField" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Advance:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="advanceField" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Action Buttons -->
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button text="Add" styleClass="btn-primary" onAction="#handleManualAdd"/>
                <Button text="Modify" styleClass="btn-secondary" onAction="#handleAutoAllocate"/>
                <Button text="Delete" styleClass="btn-danger" onAction="#handleRemoveItem"/>
                <Button fx:id="saveBtn" text="Save" styleClass="btn-primary" onAction="#handleSave"/>
                <Button text="Cancel" styleClass="btn-secondary" onAction="#handleClear"/>
                <Button text="Close" styleClass="btn-secondary" onAction="#handleClear"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
