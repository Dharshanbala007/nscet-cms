<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.TransferCertificateController"
      styleClass="master-container">
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <Label text="Transfer Certificate" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Enter Roll No to search student" styleClass="search-field" prefWidth="300"/>
        <Button text="Search Student" styleClass="btn-primary" onAction="#handleSearch"/>
    </HBox>
    <VBox VBox.vgrow="ALWAYS" spacing="10">
        <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
        <!-- Student Info -->
        <HBox spacing="30" styleClass="student-info-bar">
            <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
            <HBox spacing="5"><Label text="Student:" style="-fx-font-weight: bold;"/><Label fx:id="studentNameLabel" text="--"/></HBox>
            <HBox spacing="5"><Label text="Father:" style="-fx-font-weight: bold;"/><Label fx:id="fatherNameLabel" text="--"/></HBox>
            <HBox spacing="5"><Label text="DOB:" style="-fx-font-weight: bold;"/><Label fx:id="dobLabel" text="--"/></HBox>
            <HBox spacing="5"><Label text="Course:" style="-fx-font-weight: bold;"/><Label fx:id="courseLabel" text="--"/></HBox>
            <HBox spacing="5"><Label text="Sem:" style="-fx-font-weight: bold;"/><Label fx:id="semLabel" text="--"/></HBox>
        </HBox>
        <!-- TC Form wrapped in ScrollPane -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="borderless-scroll">
            <VBox fx:id="formPane" spacing="10" styleClass="form-container">
                <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
                <Label text="Transfer Certificate Details" styleClass="form-title"/>
                <GridPane hgap="15" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130" prefWidth="140"/>
                        <ColumnConstraints minWidth="200" prefWidth="230"/>
                        <ColumnConstraints minWidth="130" prefWidth="140"/>
                        <ColumnConstraints minWidth="200" prefWidth="230"/>
                    </columnConstraints>

                    <!-- Row 0 -->
                    <Label text="Acadamic Year:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="academicYearCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308" promptText="Select"/>
                    <Label text="Serial No :" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="serialNoField" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <!-- Row 1 -->
                    <Label text="Student Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="studentNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Reg.No:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="regNoField" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <!-- Row 2 -->
                    <Label text="Admission No:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="admissionNoField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Father Name:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="fatherNameField" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                    <!-- Row 3 -->
                    <Label text="Nationality:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="nationalityField" text="Indian" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Religion:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <TextField fx:id="religionField" text="Hindu" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                    <!-- Row 4 -->
                    <Label text="Caste:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="casteField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label text="Community:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <ComboBox fx:id="communityCombo" GridPane.columnIndex="3" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308" promptText="Select"/>

                    <!-- Row 5 -->
                    <Label text="Date of Birth:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <DatePicker fx:id="dobPicker" GridPane.columnIndex="1" GridPane.rowIndex="5" maxWidth="1.7976931348623157E308"/>
                    <TextField fx:id="dobInWordsField" promptText="Date of Birth in Words" GridPane.columnIndex="2" GridPane.rowIndex="5" GridPane.columnSpan="2"/>

                    <!-- Row 6 -->
                    <Label text="Course:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <TextField fx:id="courseField" GridPane.columnIndex="1" GridPane.rowIndex="6" GridPane.columnSpan="3"/>

                    <!-- Row 7 -->
                    <Label text="Branch:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                    <TextField fx:id="branchField" GridPane.columnIndex="1" GridPane.rowIndex="7" GridPane.columnSpan="3"/>

                    <!-- Row 8 -->
                    <Label text="Personal ID Marks:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                    <TextField fx:id="idMarksField" GridPane.columnIndex="1" GridPane.rowIndex="8" GridPane.columnSpan="3"/>

                    <!-- Row 9 -->
                    <Label text="ID Marks 2:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                    <TextField fx:id="idMarks2Field" GridPane.columnIndex="1" GridPane.rowIndex="9" GridPane.columnSpan="3"/>

                    <!-- Row 10 -->
                    <Label text="Course Completed:" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                    <TextField fx:id="courseCompletedField" GridPane.columnIndex="1" GridPane.rowIndex="10" GridPane.columnSpan="3"/>

                    <!-- Row 11 -->
                    <Label text="Qualified for Promotion:" GridPane.columnIndex="0" GridPane.rowIndex="11"/>
                    <TextField fx:id="qualifiedPromotionField" GridPane.columnIndex="1" GridPane.rowIndex="11" GridPane.columnSpan="3"/>

                    <!-- Row 12 -->
                    <Label text="Paid all Fees:" GridPane.columnIndex="0" GridPane.rowIndex="12"/>
                    <TextField fx:id="paidAllFeesField" text="Yes" GridPane.columnIndex="1" GridPane.rowIndex="12" GridPane.columnSpan="3"/>

                    <!-- Row 13 -->
                    <Label text="Date of Left:" GridPane.columnIndex="0" GridPane.rowIndex="13"/>
                    <DatePicker fx:id="leftDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="13" maxWidth="1.7976931348623157E308"/>
                    <Label text="TC Application Date:" GridPane.columnIndex="2" GridPane.rowIndex="13"/>
                    <DatePicker fx:id="appDatePicker" GridPane.columnIndex="3" GridPane.rowIndex="13" maxWidth="1.7976931348623157E308"/>

                    <!-- Row 14 -->
                    <Label text="TC Date:" GridPane.columnIndex="0" GridPane.rowIndex="14"/>
                    <DatePicker fx:id="tcDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="14" maxWidth="1.7976931348623157E308"/>
                    <Label text="Character\\Conduct:" GridPane.columnIndex="2" GridPane.rowIndex="14"/>
                    <TextField fx:id="characterField" text="Good" GridPane.columnIndex="3" GridPane.rowIndex="14"/>

                    <!-- Row 15 -->
                    <Label text="Batch:" GridPane.columnIndex="0" GridPane.rowIndex="15"/>
                    <ComboBox fx:id="batchCombo" GridPane.columnIndex="1" GridPane.rowIndex="15" maxWidth="1.7976931348623157E308" promptText="Select"/>
                    <TextField fx:id="batchDetailField" GridPane.columnIndex="2" GridPane.rowIndex="15" GridPane.columnSpan="2"/>

                    <!-- Row 16 -->
                    <Label text="UMIS No:" GridPane.columnIndex="0" GridPane.rowIndex="16"/>
                    <TextField fx:id="umisField" GridPane.columnIndex="1" GridPane.rowIndex="16"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Add" styleClass="btn-secondary" onAction="#handleClear"/>
                    <Button text="Modify" styleClass="btn-secondary" onAction="#handleSave"/>
                    <Button text="Delete" styleClass="btn-danger" onAction="#handleClear"/>
                    <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
                    <Button text="Cancel" styleClass="btn-secondary" onAction="#handleClear"/>
                    <Button text="Print TC" styleClass="btn-primary" onAction="#handlePrint"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
</VBox>
