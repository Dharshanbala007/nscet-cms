<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.StudentDetailsController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Module Header -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="Student Master Details &amp; Semester History" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search by Roll No or Name..." styleClass="search-field" onKeyTyped="#handleSearch"/>
    </HBox>

    <!-- Main Student Table -->
    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="rollNoCol" text="Roll No" prefWidth="110"/>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="180"/>
                <TableColumn fx:id="deptCol" text="Department" prefWidth="140"/>
                <TableColumn fx:id="semesterCol" text="Current Sem" prefWidth="100"/>
                <TableColumn fx:id="admissionTypeCol" text="Admission Type" prefWidth="140"/>
                <TableColumn fx:id="fineCol" text="Fine" prefWidth="100"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="10" styleClass="pagination-bar">
            <padding><Insets top="6" bottom="6"/></padding>
            <Button fx:id="prevBtn" text="Previous" onAction="#handlePrevious"/>
            <Label fx:id="pageInfo"/>
            <Button fx:id="nextBtn" text="Next" onAction="#handleNext"/>
        </HBox>
    </VBox>

    <!-- Student Details Form Pane -->
    <VBox fx:id="formPane" visible="true" managed="true" styleClass="form-container" spacing="12">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <Label text="Student Details" styleClass="form-title"/>
        
        <GridPane hgap="15" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="110" prefWidth="120"/>
                <ColumnConstraints minWidth="180" prefWidth="220"/>
                <ColumnConstraints minWidth="110" prefWidth="120"/>
                <ColumnConstraints minWidth="180" prefWidth="220"/>
            </columnConstraints>
            
            <!-- Row 0 -->
            <Label text="Student Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Dept:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="deptField" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Row 1 -->
            <Label text="Roll No:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="rollNoField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Semester:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="semesterField" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Row 2 -->
            <Label text="Reg. No:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="regNoField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Quota:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <ComboBox fx:id="quotaCombo" GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308" promptText="Select"/>

            <!-- Row 3 -->
            <Label text="Caste Category:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox fx:id="casteCategoryCombo" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308" promptText="Select"/>
            <Label text="Bus Stop:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <TextField fx:id="busStopField" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

            <!-- Row 4 -->
            <Label text="Hostel:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <ComboBox fx:id="hostelCombo" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308" promptText="Select"/>
            <Label text="Bus Route:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
            <TextField fx:id="busRouteField" GridPane.columnIndex="3" GridPane.rowIndex="4"/>

            <!-- Row 5 -->
            <Label text="State:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <ComboBox fx:id="stateCombo" GridPane.columnIndex="1" GridPane.rowIndex="5" maxWidth="1.7976931348623157E308" promptText="Select"/>
            <Label text="Transport Type:" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
            <ComboBox fx:id="transportTypeCombo" GridPane.columnIndex="3" GridPane.rowIndex="5" maxWidth="1.7976931348623157E308" promptText="Select"/>

            <!-- Row 6 -->
            <Label text="Academic Year:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <ComboBox fx:id="academicYearCombo" GridPane.columnIndex="1" GridPane.rowIndex="6" maxWidth="1.7976931348623157E308" promptText="Select"/>
            <Label text="Sem Type:" GridPane.columnIndex="2" GridPane.rowIndex="6"/>
            <ComboBox fx:id="semTypeCombo" GridPane.columnIndex="3" GridPane.rowIndex="6" maxWidth="1.7976931348623157E308" promptText="Select"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Add" styleClass="btn-secondary" onAction="#handleAdd"/>
            <Button text="Edit" styleClass="btn-secondary" onAction="#handleModify"/>
            <Button text="Delete" styleClass="btn-danger" onAction="#handleDeleteSelected"/>
            <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
            <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        </HBox>
    </VBox>
</VBox>
