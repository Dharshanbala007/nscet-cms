<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.FeesDetailsController"
      styleClass="master-container">

    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <Label text="Fees Details" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search..." styleClass="search-field" onKeyTyped="#handleSearch"/>
        <Button text="Add" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <padding><Insets top="0" right="20" bottom="0" left="20"/></padding>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table" prefHeight="300">
            <columns>
                <TableColumn fx:id="semesterCol" text="Semester" prefWidth="80"/>
                <TableColumn fx:id="feesNameCol" text="Fees Name" prefWidth="150"/>
                <TableColumn fx:id="admissionTypeCol" text="Admission Type" prefWidth="110"/>
                <TableColumn fx:id="amountCol" text="Amount" prefWidth="100"/>
                <TableColumn fx:id="fromDateCol" text="From Date" prefWidth="100"/>
                <TableColumn fx:id="toDateCol" text="To Date" prefWidth="100"/>
                <TableColumn fx:id="quotaCol" text="Quota" prefWidth="100"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="10" styleClass="pagination-bar">
            <padding><Insets top="10" bottom="10"/></padding>
            <Button fx:id="prevBtn" text="Previous" onAction="#handlePrevious"/>
            <Label fx:id="pageInfo"/>
            <Button fx:id="nextBtn" text="Next" onAction="#handleNext"/>
        </HBox>
    </VBox>

    <VBox fx:id="formPane" visible="false" managed="false" styleClass="form-container" spacing="15">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        <Label text="Fee Details" styleClass="form-title"/>
        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
                <ColumnConstraints minWidth="200" prefWidth="250"/>
                <ColumnConstraints minWidth="15" prefWidth="15"/>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
                <ColumnConstraints minWidth="200" prefWidth="250"/>
            </columnConstraints>

            <Label text="From Date:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <DatePicker fx:id="fromDate" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="To Date:" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <DatePicker fx:id="toDate" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

            <Label text="Degree:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="degreeCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Select"/>

            <Label text="Fees:" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            <ComboBox fx:id="feesCombo" GridPane.columnIndex="4" GridPane.rowIndex="1" promptText="Select"/>

            <Label text="Semester:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="semesterCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Select"/>

            <Label text="Admission Type:" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            <ComboBox fx:id="admissionTypeCombo" GridPane.columnIndex="4" GridPane.rowIndex="2" promptText="Select"/>

            <Label text="Quota:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox fx:id="quotaCombo" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Select"/>

            <Label text="Dept:" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
            <ComboBox fx:id="deptCombo" GridPane.columnIndex="4" GridPane.rowIndex="3" promptText="Select"/>

            <Label text="Amount:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="amountField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="5"/></padding>
            <Button text="Add" styleClass="btn-primary" onAction="#handleFormAdd"/>
            <Button text="Modify" styleClass="btn-secondary" onAction="#handleFormModify"/>
            <Button text="Delete" styleClass="btn-danger" onAction="#handleFormDelete"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
            <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
            <Button text="Close" styleClass="btn-secondary" onAction="#handleClose"/>
        </HBox>
    </VBox>
</VBox>
