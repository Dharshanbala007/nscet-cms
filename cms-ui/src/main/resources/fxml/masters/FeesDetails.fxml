<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.FeesDetailsController"
      styleClass="master-container" spacing="10">

    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
        <Label text="Fees Details" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="12">
        <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>

        <!-- Top Control / Report Order Bar matching Screenshots media_1787820088067.png & media_1787842262568.jpg -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="form-container">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
            <Label text="Acadamic Period:"/>
            <ComboBox fx:id="academicPeriodCombo" prefWidth="120" promptText="2025-26"/>

            <RadioButton fx:id="oddRadio" text="Odd" selected="true">
                <toggleGroup><ToggleGroup fx:id="periodGroup"/></toggleGroup>
            </RadioButton>
            <RadioButton fx:id="evenRadio" text="Even" toggleGroup="$periodGroup"/>
            <RadioButton fx:id="yearlyRadio" text="Yearly" toggleGroup="$periodGroup"/>

            <Label text="Report Order:"/>
            <ComboBox fx:id="reportOrderCombo" prefWidth="120" promptText="Deptwise"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="View" styleClass="btn-primary" onAction="#handleView"/>
            <Button text="Print" styleClass="btn-secondary" onAction="#handlePrint"/>
        </HBox>

        <!-- Form Pane matching Screenshot media_1787842262568.jpg -->
        <VBox styleClass="form-container" spacing="10">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <GridPane hgap="15" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="90" prefWidth="100"/>
                    <ColumnConstraints minWidth="160" prefWidth="180"/>
                    <ColumnConstraints minWidth="90" prefWidth="110"/>
                    <ColumnConstraints minWidth="160" prefWidth="180"/>
                </columnConstraints>

                <!-- Row 0 -->
                <Label text="From Date:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <DatePicker fx:id="fromDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>
                <Label text="To Date:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <DatePicker fx:id="toDatePicker" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>

                <!-- Row 1 -->
                <Label text="Degree:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="degreeCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308" promptText="Select"/>
                <Label text="Fees:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <ComboBox fx:id="feesCombo" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308" promptText="Select"/>

                <!-- Row 2 -->
                <Label text="Semester:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="semesterCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308" promptText="Select"/>
                <Label text="Admission Type:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <ComboBox fx:id="admissionTypeCombo" GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308" promptText="Select"/>

                <!-- Row 3 -->
                <Label text="Quota:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="quotaCombo" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308" promptText="Select"/>
                <Label text="Dept:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <ComboBox fx:id="deptCombo" GridPane.columnIndex="3" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308" promptText="Select"/>

                <!-- Row 4 -->
                <Label text="State:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="stateCombo" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308" promptText="Select"/>
                <Label text="Amount:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <TextField fx:id="amountField" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
            </GridPane>

            <!-- Bottom Action Bar matching media_1787842262568.jpg -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Add" styleClass="btn-secondary" onAction="#handleAdd"/>
                <Button text="Modify" styleClass="btn-secondary" onAction="#handleModify"/>
                <Button text="Delete" styleClass="btn-danger" onAction="#handleDeleteSelected"/>
                <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
                <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
                <Button text="Close" styleClass="btn-secondary" onAction="#handleClose"/>
            </HBox>
        </VBox>

        <!-- Data Table View -->
        <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="branchCol" text="Branch" prefWidth="80"/>
                <TableColumn fx:id="semCol" text="Semester" prefWidth="70"/>
                <TableColumn fx:id="strengthCol" text="Strength" prefWidth="65"/>
                <TableColumn fx:id="prePendingCol" text="Pre.Pending" prefWidth="90"/>
                <TableColumn fx:id="tuitionFeeCol" text="Tuition Fee" prefWidth="100"/>
                <TableColumn fx:id="otherFeesCol" text="Other Fees" prefWidth="95"/>
                <TableColumn fx:id="busFeesCol" text="Bus Fees" prefWidth="90"/>
                <TableColumn fx:id="totalAmountCol" text="Total Amount" prefWidth="110"/>
                <TableColumn fx:id="paidAmountCol" text="Paid Amount" prefWidth="100"/>
                <TableColumn fx:id="pendingAmountCol" text="Pending Amount" prefWidth="110"/>
                <TableColumn fx:id="colAmtCol" text="Col Amt" prefWidth="90"/>
                <TableColumn fx:id="karAmtCol" text="Kar Amt" prefWidth="85"/>
                <TableColumn fx:id="busAmtCol" text="Bus Amt" prefWidth="85"/>
                <TableColumn fx:id="pendTuitionCol" text="PendTuition" prefWidth="90"/>
                <TableColumn fx:id="pendOtherCol" text="Pendother" prefWidth="90"/>
                <TableColumn fx:id="pendBusCol" text="Pendbus" prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
