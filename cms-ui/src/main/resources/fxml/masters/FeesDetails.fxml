<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.FeesDetailsController"
      styleClass="master-container" spacing="0">

    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <Label text="Fees Details" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search..." styleClass="search-field" onKeyTyped="#handleSearch"/>
        <Button text="Add" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <padding><Insets top="0" right="20" bottom="0" left="20"/></padding>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="feeNameCol" text="Fee Name" prefWidth="150"/>
                <TableColumn fx:id="feeTypeCol" text="Fee Type" prefWidth="100"/>
                <TableColumn fx:id="amountCol" text="Amount" prefWidth="120"/>
                <TableColumn fx:id="deptCol" text="Department" prefWidth="120"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="10" styleClass="pagination-bar">
            <padding><Insets top="8" bottom="8"/></padding>
            <Button fx:id="prevBtn" text="Previous" onAction="#handlePrevious"/>
            <Label fx:id="pageInfo"/>
            <Button fx:id="nextBtn" text="Next" onAction="#handleNext"/>
        </HBox>
    </VBox>

    <VBox fx:id="formPane" visible="false" managed="false" styleClass="form-container" spacing="15">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <Label text="Fee Details" styleClass="form-title"/>
        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
                <ColumnConstraints minWidth="200" prefWidth="250"/>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
                <ColumnConstraints minWidth="200" prefWidth="250"/>
            </columnConstraints>
            <Label text="Fee Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="feeNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Fee Type:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="feeTypeCombo" GridPane.columnIndex="3" GridPane.rowIndex="0" promptText="Select"/>
            <Label text="Amount:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="amountField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Department:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="deptCombo" GridPane.columnIndex="3" GridPane.rowIndex="1" promptText="Select"/>
        </GridPane>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
            <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        </HBox>
    </VBox>
</VBox>
