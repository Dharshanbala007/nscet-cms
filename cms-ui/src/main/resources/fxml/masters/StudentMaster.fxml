<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.StudentMasterController"
      styleClass="master-container" spacing="10">
    <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>

    <!-- Module Header with Search -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="Student Master" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search by roll, name, admission no..." styleClass="search-field" onKeyTyped="#handleSearch" prefWidth="250"/>
    </HBox>

    <!-- Data Table Container -->
    <VBox VBox.vgrow="ALWAYS" styleClass="table-container" prefHeight="200">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="rollCol" text="Roll No" prefWidth="100"/>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="160"/>
                <TableColumn fx:id="fatherCol" text="Father Name" prefWidth="140"/>
                <TableColumn fx:id="genderCol" text="Gender" prefWidth="70"/>
                <TableColumn fx:id="phoneCol" text="Phone" prefWidth="100"/>
                <TableColumn fx:id="admNoCol" text="Admission No" prefWidth="120"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="10" styleClass="pagination-bar">
            <padding><Insets top="4" bottom="4"/></padding>
            <Button fx:id="prevBtn" text="Previous" onAction="#handlePrevious"/>
            <Label fx:id="pageInfo"/>
            <Button fx:id="nextBtn" text="Next" onAction="#handleNext"/>
        </HBox>
    </VBox>

    <!-- Student Master Form Pane (Matching media_1787910508974.png) -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" prefHeight="380">
        <VBox fx:id="formPane" styleClass="form-container" spacing="10">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>

            <!-- Basic Student Info Grid -->
            <GridPane hgap="12" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="110"/>
                    <ColumnConstraints minWidth="200" prefWidth="240"/>
                    <ColumnConstraints minWidth="100" prefWidth="110"/>
                    <ColumnConstraints minWidth="200" prefWidth="240"/>
                </columnConstraints>

                <!-- Row 0: Degree & Date of Joining -->
                <Label text="Degree:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="degreeCombo" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Select"/>

                <Label text="Date of Joining:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="dojPicker" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <!-- Row 1: Dept & Section -->
                <Label text="Dept:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="deptCombo" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Select"/>

                <Label text="Section:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <TextField fx:id="sectionField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <!-- Row 2: Admission No & Student Name -->
                <Label text="Admission No:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <TextField fx:id="admNoField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Student Name:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <TextField fx:id="nameField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <!-- Row 3: Reg.No & Date of Birth -->
                <Label text="Reg.No:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                <TextField fx:id="regField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Date of Birth:" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="dobPicker" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                <!-- Row 4: Gender & Aadhar No -->
                <Label text="Gender:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="genderCombo" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="4" promptText="Select"/>

                <Label text="Aadhar No:" GridPane.columnIndex="2" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                <TextField fx:id="aadharField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
            </GridPane>

            <!-- Family Details Group -->
            <TitledPane text="Family Details" collapsible="false">
                <GridPane hgap="12" vgap="8">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="110"/>
                        <ColumnConstraints minWidth="200" prefWidth="240"/>
                        <ColumnConstraints minWidth="100" prefWidth="110"/>
                        <ColumnConstraints minWidth="200" prefWidth="240"/>
                    </columnConstraints>

                    <Label text="Father's Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="fatherField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Mother's Name:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="motherField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Occupation:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="fatherOccupationField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Occupation:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="motherOccupationField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Parents Phone:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="parentPhoneField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Student Phone:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="phoneField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                    <Label text="Religion:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="religionCombo" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Select"/>

                    <Label text="Community:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="communityCombo" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="3" promptText="Select"/>

                    <Label text="Caste :" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="casteField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>
            </TitledPane>

            <!-- Communication Details Group -->
            <TitledPane text="Communication Details" collapsible="false">
                <GridPane hgap="12" vgap="8">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="110"/>
                        <ColumnConstraints minWidth="200" prefWidth="240"/>
                        <ColumnConstraints minWidth="100" prefWidth="110"/>
                        <ColumnConstraints minWidth="200" prefWidth="240"/>
                    </columnConstraints>

                    <Label text="Address 1:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="address1Field" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Address 2:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="address2Field" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="City:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="cityField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Pin Code:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="pinCodeField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="emailField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
            </TitledPane>

            <!-- Educational Details Group -->
            <TitledPane text="Educational Details" collapsible="false">
                <GridPane hgap="12" vgap="8">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="110"/>
                        <ColumnConstraints minWidth="200" prefWidth="240"/>
                        <ColumnConstraints minWidth="100" prefWidth="110"/>
                        <ColumnConstraints minWidth="200" prefWidth="240"/>
                    </columnConstraints>

                    <Label text="10th Mark:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="tenthMarkField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="HSC Mark:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="hscMarkField" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Cut Off Mark:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="cutOffField" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Year of Passing :" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="yearOfPassingField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Medium:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="mediumCombo" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Select"/>

                    <Label text="Board of Study:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="boardOfStudyField" prefWidth="240" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                    <Label text="Qualifying Exam:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="qualifyingExamCombo" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Select"/>
                </GridPane>
            </TitledPane>

            <!-- Action Buttons Bar -->
            <HBox spacing="10" alignment="CENTER" styleClass="button-bar">
                <padding><Insets top="5" bottom="5"/></padding>
                <Button text="Add" styleClass="btn-action" onAction="#handleAdd" prefWidth="80"/>
                <Button text="Modify" styleClass="btn-action" onAction="#handleModify" prefWidth="80"/>
                <Button text="Delete" styleClass="btn-action-danger" onAction="#handleDeleteSelected" prefWidth="80"/>
                <Button text="Save" styleClass="btn-action-primary" onAction="#handleSave" prefWidth="80"/>
                <Button text="Cancel" styleClass="btn-action" onAction="#handleCancel" prefWidth="80"/>
                <Button text="Close" styleClass="btn-action" onAction="#handleClose" prefWidth="80"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
