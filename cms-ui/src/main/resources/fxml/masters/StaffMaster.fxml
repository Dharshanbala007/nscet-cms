<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.StaffMasterController"
      styleClass="master-container">
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <Label text="Staff Master" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search by code or name..." styleClass="search-field" onKeyTyped="#handleSearch"/>
        <Button text="Add New Staff" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>
    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <padding><Insets top="0" right="20" bottom="0" left="20"/></padding>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="codeCol" text="Staff Code" prefWidth="90"/>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="180"/>
                <TableColumn fx:id="deptCol" text="Department" prefWidth="130"/>
                <TableColumn fx:id="desigCol" text="Designation" prefWidth="130"/>
                <TableColumn fx:id="catCol" text="Category" prefWidth="100"/>
                <TableColumn fx:id="phoneCol" text="Phone" prefWidth="100"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="10" styleClass="pagination-bar">
            <padding><Insets top="10" bottom="10"/></padding>
            <Button fx:id="prevBtn" text="Previous" onAction="#handlePrevious"/>
            <Label fx:id="pageInfo"/>
            <Button fx:id="nextBtn" text="Next" onAction="#handleNext"/>
        </HBox>
    </VBox>
    <VBox fx:id="formPane" visible="false" managed="false" styleClass="form-container" spacing="10">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">
            <Tab text="Official Details">
                <GridPane hgap="10" vgap="6">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120"/>
                        <ColumnConstraints minWidth="160" prefWidth="180"/>
                        <ColumnConstraints minWidth="100" prefWidth="120"/>
                        <ColumnConstraints minWidth="160" prefWidth="180"/>
                    </columnConstraints>
                    <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="categoryCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308" promptText="Select"/>
                    <Label text="Date of Joining:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="dojPicker" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>
                    <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="deptCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308" promptText="Select"/>
                    <Label text="Designation:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="desigCombo" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308" promptText="Select"/>
                    <Label text="Staff Group:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="staffGroupField" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"/>
                    <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="emailField" GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"/>
                    <Label text="College Code:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="collegeCodeField" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"/>
                    <Label text="Transport:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="transportCombo" GridPane.columnIndex="3" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308" promptText="Select"/>
                    <Label text="Essl Id:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="esslField" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308"/>
                    <Label text="EPF DOJ:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <CheckBox fx:id="pfCheck" GridPane.columnIndex="3" GridPane.rowIndex="4" text="PF Active"/>
                </GridPane>
            </Tab>
            <Tab text="Personal Details">
                <GridPane hgap="10" vgap="6">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120"/>
                        <ColumnConstraints minWidth="160" prefWidth="180"/>
                        <ColumnConstraints minWidth="100" prefWidth="120"/>
                        <ColumnConstraints minWidth="160" prefWidth="180"/>
                    </columnConstraints>
                    <Label text="Staff Code:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="staffCodeField" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>
                    <Label text="Address 1:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="address1Field" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>
                    <Label text="Staff Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"/>
                    <Label text="Address 2:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="address2Field" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"/>
                    <Label text="Sex:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="genderCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308" promptText="Select"/>
                    <Label text="City:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="cityField" GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"/>
                    <Label text="Date of Birth:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <DatePicker fx:id="dobPicker" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"/>
                    <Label text="Pin Code:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <TextField fx:id="pinField" GridPane.columnIndex="3" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"/>
                    <Label text="Cell No:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308"/>
                    <Label text="Blood Group:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <TextField fx:id="bloodGroupField" GridPane.columnIndex="3" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308"/>
                    <Label text="Aadhar Number:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <TextField fx:id="aadharField" GridPane.columnIndex="1" GridPane.rowIndex="5" maxWidth="1.7976931348623157E308"/>
                    <CheckBox fx:id="activeCheck" GridPane.columnIndex="3" GridPane.rowIndex="5" text="Active" selected="true"/>
                </GridPane>
            </Tab>
        </TabPane>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding><Insets top="5"/></padding>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="warningLabel" styleClass="warning-label" text=""/>
            <Button text="Add" styleClass="btn-secondary" onAction="#handleAdd"/>
            <Button text="Modify" styleClass="btn-secondary" onAction="#handleModify"/>
            <Button text="Delete" styleClass="btn-danger" onAction="#handleDeleteSelected"/>
            <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
            <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
            <Button text="Close" styleClass="btn-secondary" onAction="#handleClose"/>
        </HBox>
    </VBox>
</VBox>
