<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.UserMasterController"
      styleClass="master-container">

    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <Label text="User Master" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search user..." styleClass="search-field" onKeyTyped="#handleSearch"/>
        <Button text="Add User" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <padding><Insets top="0" right="20" bottom="0" left="20"/></padding>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="usernameCol" text="Username" prefWidth="130"/>
                <TableColumn fx:id="fullNameCol" text="Full Name" prefWidth="180"/>
                <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                <TableColumn fx:id="roleCol" text="Role" prefWidth="120"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="150"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="10" styleClass="pagination-bar">
            <padding><Insets top="10" bottom="10"/></padding>
            <Button fx:id="prevBtn" text="Previous" onAction="#handlePrevious"/>
            <Label fx:id="pageInfo"/>
            <Button fx:id="nextBtn" text="Next" onAction="#handleNext"/>
        </HBox>
    </VBox>

    <VBox fx:id="formPane" visible="false" managed="false" styleClass="form-container" spacing="15">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        <Label fx:id="formTitleLabel" text="User Details" styleClass="form-title"/>
        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
                <ColumnConstraints minWidth="200" prefWidth="250"/>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
                <ColumnConstraints minWidth="200" prefWidth="250"/>
            </columnConstraints>

            <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Full Name:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="fullNameField" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Role:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="roleCombo" GridPane.columnIndex="3" GridPane.rowIndex="1" promptText="Select Role"/>

            <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <PasswordField fx:id="passwordField" promptText="Leave empty to keep existing" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Lock Account:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <CheckBox fx:id="lockedCheck" text="Locked" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
            <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        </HBox>
    </VBox>
</VBox>
