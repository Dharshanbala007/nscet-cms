<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.PettyCashSuspenseController"
      styleClass="master-container" spacing="15">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <fx:define>
        <ToggleGroup fx:id="sourceGroup"/>
    </fx:define>

    <!-- Module Title Header -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Petty Cash (Suspense Amount)" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox spacing="12" styleClass="form-container">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

        <!-- College / Hostel Radio Buttons -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <RadioButton fx:id="collegeRadio" text="College" toggleGroup="$sourceGroup" selected="true" style="-fx-font-weight: bold;"/>
            <RadioButton fx:id="hostelRadio" text="Hostel" toggleGroup="$sourceGroup" style="-fx-font-weight: bold;"/>
        </HBox>

        <GridPane hgap="15" vgap="10">
            <!-- Row 1: Sus.V.No & Date -->
            <Label text="Sus.V.No:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <TextField fx:id="voucherNoField" prefWidth="220" editable="false" styleClass="readonly-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="datePicker" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Row 2: Staff Name & Staff Code -->
            <Label text="Staff Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <TextField fx:id="staffNameField" prefWidth="220" promptText="Staff Name" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Staff Code:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <TextField fx:id="staffCodeField" prefWidth="180" promptText="Staff Code" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Row 3: Designation & Dept -->
            <Label text="Designation:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <TextField fx:id="designationField" prefWidth="220" promptText="Designation" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Dept:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <TextField fx:id="deptField" prefWidth="180" promptText="Department" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <!-- Row 4: Amount & Amount in Words -->
            <Label text="Amount:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
            <TextField fx:id="amountField" prefWidth="220" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Amount (in words):" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
            <TextField fx:id="amountWordsField" prefWidth="240" editable="false" styleClass="readonly-field" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
        </GridPane>

        <!-- Purpose TextArea -->
        <VBox spacing="4">
            <Label text="Purpose:" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="purposeField" prefHeight="65" promptText="Purpose..." wrapText="true"/>
        </VBox>

        <!-- Action Button Bar -->
        <HBox spacing="10" alignment="CENTER" styleClass="button-bar">
            <padding><Insets top="5" bottom="5"/></padding>
            <Button text="Add" styleClass="btn-action" onAction="#handleAdd" prefWidth="90"/>
            <Button text="Modify" styleClass="btn-action" onAction="#handleModify" prefWidth="90"/>
            <Button text="Delete" styleClass="btn-action-danger" onAction="#handleDelete" prefWidth="90"/>
            <Button text="Cancel" styleClass="btn-action" onAction="#handleCancel" prefWidth="90"/>
            <Button text="Save" styleClass="btn-action-primary" onAction="#handleSave" prefWidth="90"/>
            <Button text="Close" styleClass="btn-action" onAction="#handleClose" prefWidth="90"/>
        </HBox>

        <!-- Data Table -->
        <TableView fx:id="dataTable" prefHeight="220" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colSlNo" text="Sl.No" prefWidth="50"/>
                <TableColumn fx:id="colVNo" text="V.No" prefWidth="110"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                <TableColumn fx:id="colStaffCode" text="Staff Code" prefWidth="100"/>
                <TableColumn fx:id="colStaff" text="Staff Name" prefWidth="160"/>
                <TableColumn fx:id="colDept" text="Dept" prefWidth="100"/>
                <TableColumn fx:id="colAmount" text="Amount" prefWidth="110"/>
                <TableColumn fx:id="colPurpose" text="Purpose" prefWidth="220"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
