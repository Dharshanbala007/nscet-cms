<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.PettyVoucherController"
      styleClass="master-container" spacing="10">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Header Title -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Petty Cash Bill \ Voucher" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox spacing="10" styleClass="form-container">
        <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>

        <!-- Top Fields Grid -->
        <GridPane hgap="15" vgap="8">
            <Label text="V.No:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <TextField fx:id="voucherNoField" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="datePicker" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Staff Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <TextField fx:id="staffNameField" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Staff Code:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <TextField fx:id="staffCodeField" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Designation:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <TextField fx:id="designationField" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Dept:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <TextField fx:id="deptField" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>

        <!-- Suspense Details Group Card -->
        <VBox style="-fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-border-radius: 4; -fx-padding: 8 12; -fx-background-color: #fafafa;" spacing="6">
            <Label text="Suspense Details" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
            <GridPane hgap="15" vgap="6">
                <Label text="Sus.V.No:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <TextField fx:id="susVNoField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="susDatePicker" prefWidth="180" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Amount:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <TextField fx:id="susAmountField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>

        <!-- Purpose TextArea -->
        <VBox spacing="4">
            <Label text="Purpose :" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="purposeField" prefHeight="55" promptText="Enter Purpose..." wrapText="true"/>
        </VBox>

        <!-- Line Item Input Row -->
        <VBox spacing="6">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Date:" style="-fx-font-weight: bold;"/>
                    <DatePicker fx:id="itemDatePicker" prefWidth="140"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="Details:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="itemDetailsField" HBox.hgrow="ALWAYS" promptText="Enter Item Details"/>
                </HBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Att.No:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="itemAttNoField" prefWidth="120"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Type:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="itemTypeCombo" prefWidth="130"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Amount:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="itemAmountField" prefWidth="130" promptText="0.00"/>
                </HBox>
                <Button text="Add Item" styleClass="btn-action-primary" onAction="#handleAddItem"/>
            </HBox>
        </VBox>

        <!-- Items Table -->
        <TableView fx:id="itemsTable" prefHeight="160" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colItemDate" text="Date" prefWidth="110"/>
                <TableColumn fx:id="colItemDetails" text="Details" prefWidth="220"/>
                <TableColumn fx:id="colItemAttNo" text="Att.No" prefWidth="90"/>
                <TableColumn fx:id="colItemType" text="Type" prefWidth="120"/>
                <TableColumn fx:id="colItemAmount" text="Amount" prefWidth="110"/>
            </columns>
        </TableView>

        <!-- Total Amount Footer Row -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label text="Total Amount:" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
            <TextField fx:id="totalAmountField" prefWidth="140" editable="false" style="-fx-font-weight: bold; -fx-alignment: CENTER-RIGHT;" text="0"/>
        </HBox>
    </VBox>

    <!-- Bottom Action Button Bar matching screenshot media_1787906998916.png -->
    <HBox alignment="CENTER" spacing="10" styleClass="form-container">
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
        <Button text="Add" styleClass="btn-action" onAction="#handleAdd" prefWidth="90"/>
        <Button text="Modify" styleClass="btn-action" onAction="#handleModify" prefWidth="90"/>
        <Button text="Delete" styleClass="btn-action-danger" onAction="#handleDelete" prefWidth="90"/>
        <Button text="Save" styleClass="btn-action-primary" onAction="#handleSave" prefWidth="90"/>
        <Button text="Cancel" styleClass="btn-action" onAction="#handleCancel" prefWidth="90"/>
        <Button text="Close" styleClass="btn-action" onAction="#handleClose" prefWidth="90"/>
    </HBox>

</VBox>
