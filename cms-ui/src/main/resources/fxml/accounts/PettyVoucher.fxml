<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.PettyVoucherController"
      styleClass="master-container" spacing="10">
    <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>

    <Label text="Petty Cash Bill / Voucher" styleClass="module-title"/>

    <VBox spacing="8" styleClass="form-container">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

        <!-- Row 1: V.No, Date -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="V.No:" prefWidth="60"/>
                <TextField fx:id="voucherNoField" prefWidth="150" editable="false" styleClass="readonly-field"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Date:" prefWidth="50"/>
                <DatePicker fx:id="datePicker" prefWidth="150"/>
            </HBox>
        </HBox>

        <!-- Row 2: Staff Name, Staff Code -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Staff Name:" prefWidth="80"/>
                <TextField fx:id="staffNameField" prefWidth="150" promptText="Staff Name"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Staff Code:" prefWidth="80"/>
                <TextField fx:id="staffCodeField" prefWidth="150" promptText="Staff Code"/>
            </HBox>
        </HBox>

        <!-- Row 3: Designation, Dept -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Designation:" prefWidth="80"/>
                <TextField fx:id="designationField" prefWidth="150" promptText="Designation"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Dept:" prefWidth="50"/>
                <TextField fx:id="deptField" prefWidth="150" promptText="Department"/>
            </HBox>
        </HBox>

        <!-- Suspense Details -->
        <TitledPane text="Suspense Details" collapsible="true" styleClass="form-container">
            <GridPane hgap="10" vgap="8">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="Sus.V.No:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="susVNoField" prefWidth="130" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <DatePicker fx:id="susDatePicker" prefWidth="130" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Amount:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="susAmountField" prefWidth="130" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
        </TitledPane>

        <!-- Purpose -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Purpose:"/>
        </HBox>
        <TextArea fx:id="purposeField" prefHeight="50" prefWidth="500" promptText="Purpose"/>

        <!-- Items Table Header -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Items:" styleClass="section-title"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Date:" prefWidth="40"/>
                <DatePicker fx:id="itemDatePicker" prefWidth="120"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Details:" prefWidth="50"/>
                <TextField fx:id="itemDetailsField" prefWidth="150"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Att.No:" prefWidth="50"/>
                <TextField fx:id="itemAttNoField" prefWidth="80"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Type:" prefWidth="40"/>
                <ComboBox fx:id="itemTypeCombo" prefWidth="100" promptText="Select"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Amount:" prefWidth="50"/>
                <TextField fx:id="itemAmountField" prefWidth="80" promptText="0.00"/>
            </HBox>
            <Button text="+" styleClass="save-button" onAction="#handleAddItem" prefWidth="30"/>
        </HBox>

        <TableView fx:id="itemsTable" prefHeight="150" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colItemDate" text="Date" prefWidth="100"/>
                <TableColumn fx:id="colItemDetails" text="Details" prefWidth="180"/>
                <TableColumn fx:id="colItemAttNo" text="Att.No" prefWidth="80"/>
                <TableColumn fx:id="colItemType" text="Type" prefWidth="100"/>
                <TableColumn fx:id="colItemAmount" text="Amount" prefWidth="100"/>
                <TableColumn fx:id="colItemAction" text="" prefWidth="50"/>
            </columns>
        </TableView>

        <!-- Total -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Total Amount:" styleClass="section-title"/>
            <TextField fx:id="totalAmountField" prefWidth="120" editable="false" styleClass="readonly-field"/>
        </HBox>

        <!-- Buttons -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="button-bar">
            <padding><Insets top="5"/></padding>
            <Button text="Add" styleClass="save-button" onAction="#handleAdd"/>
            <Button text="Modify" styleClass="dash-action-btn" onAction="#handleModify"/>
            <Button text="Delete" styleClass="cancel-button" onAction="#handleDelete"/>
            <Button text="Save" styleClass="save-button" onAction="#handleSave"/>
            <Button text="Cancel" styleClass="cancel-button" onAction="#handleCancel"/>
            <Button text="Close" styleClass="cancel-button" onAction="#handleClose"/>
        </HBox>
    </VBox>
</VBox>
