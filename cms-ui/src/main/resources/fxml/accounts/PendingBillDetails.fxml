<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.accounts.PendingBillDetailsController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Top Action Bar -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Pending Bill Details" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox spacing="12" styleClass="form-container">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

        <GridPane hgap="15" vgap="10">
            <!-- Row 1: Supplier & Date -->
            <Label text="Supplier:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <TextField fx:id="supplierField" promptText="Supplier Name" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="240"/>
            
            <Label text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="datePicker" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="180"/>

            <!-- Row 2: Item & Dept -->
            <Label text="Item:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <TextField fx:id="itemField" promptText="Item Name" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="240"/>

            <Label text="Dept:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="deptCombo" GridPane.columnIndex="3" GridPane.rowIndex="1" prefWidth="180"/>

            <!-- Row 3: Details (Full Width) -->
            <Label text="Details:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <TextField fx:id="detailsField" promptText="Enter Bill Details..." GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3" HBox.hgrow="ALWAYS"/>
        </GridPane>

        <Separator style="-fx-padding: 4 0;"/>

        <!-- Row 4: Bill No, Bill Date, Amount -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Bill No:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="billNoField" prefWidth="160" promptText="Enter Bill No"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Bill Date:" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="billDatePicker" prefWidth="150"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Amount:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="amountField" prefWidth="160" promptText="0.00"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Data Table Container -->
    <VBox VBox.vgrow="ALWAYS" spacing="8" styleClass="form-container">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table" prefHeight="260">
            <columns>
                <TableColumn fx:id="colBillNo" text="Bill No" prefWidth="130"/>
                <TableColumn fx:id="colBillDate" text="Bill Date" prefWidth="120"/>
                <TableColumn fx:id="colSupplier" text="Supplier" prefWidth="180"/>
                <TableColumn fx:id="colItem" text="Item Name" prefWidth="160"/>
                <TableColumn fx:id="colDetails" text="Details" prefWidth="220"/>
                <TableColumn fx:id="colAmount" text="Amount" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Bottom Action Button Bar matching screenshot media_1787906609298.png -->
    <HBox alignment="CENTER" spacing="10" styleClass="form-container">
        <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
        <Button text="Add" styleClass="btn-action" onAction="#handleAdd" prefWidth="90"/>
        <Button text="Modify" styleClass="btn-action" onAction="#handleModify" prefWidth="90"/>
        <Button text="Delete" styleClass="btn-action-danger" onAction="#handleDelete" prefWidth="90"/>
        <Button text="Save" styleClass="btn-action-primary" onAction="#handleSave" prefWidth="90"/>
        <Button text="Cancel" styleClass="btn-action" onAction="#handleClear" prefWidth="90"/>
        <Button text="Close" styleClass="btn-action" onAction="#handleClose" prefWidth="90"/>
    </HBox>

</VBox>
