<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nscet.cms.ui.controller.FunctionExpenseController"
      styleClass="master-container" spacing="12">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <!-- Module Header with Find / Exit Top Toolbar -->
    <HBox styleClass="module-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Other Function Expense Details" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Find" styleClass="btn-action" onAction="#handleSearch" prefWidth="80"/>
        <Button text="Exit" styleClass="btn-action" onAction="#handleExit" prefWidth="80"/>
    </HBox>

    <!-- Main Form Fields Container -->
    <VBox spacing="10" styleClass="form-container">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

        <GridPane hgap="15" vgap="10">
            <!-- Row 1: Transaction Date & Function Name -->
            <Label text="Transaction Date:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="datePicker" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Function Name:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="functionNameCombo" prefWidth="260" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Row 2: Trans Type & Balance -->
            <Label text="Trans Type:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="transTypeCombo" prefWidth="220" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Balance:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <TextField fx:id="balanceField" prefWidth="260" editable="false" styleClass="readonly-field" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Row 3: Amount & Cur.Balance -->
            <Label text="Amount:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <TextField fx:id="amountField" prefWidth="220" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Cur.Balance:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <TextField fx:id="curBalanceField" prefWidth="260" editable="false" styleClass="readonly-field" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <!-- Row 4: Fund Transfer & Transfer To -->
            <Label text="Fund Transfer:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="fundTransferCombo" prefWidth="220" promptText="Select" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Transfer To:" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="transferToCombo" prefWidth="260" promptText="Select" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

            <!-- Row 5: Remarks -->
            <Label text="Remarks:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
            <TextField fx:id="remarksField" promptText="Enter Remarks..." GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.columnSpan="3" HBox.hgrow="ALWAYS"/>
        </GridPane>

        <!-- Save & Print Buttons Bar -->
        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 6 0 0 0;">
            <Button text="Save" styleClass="btn-action-primary" onAction="#handleSave" prefWidth="100"/>
            <Button text="Print" styleClass="btn-action" onAction="#handlePrint" prefWidth="100"/>
        </HBox>
    </VBox>

    <!-- Function Expense Data Table -->
    <VBox VBox.vgrow="ALWAYS" spacing="8" styleClass="form-container">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="240" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colSlNo" text="S.No" prefWidth="60"/>
                <TableColumn fx:id="colDate" text="Trans Date" prefWidth="110"/>
                <TableColumn fx:id="colFunctionName" text="Function Name" prefWidth="220"/>
                <TableColumn fx:id="colTransType" text="Trans Type" prefWidth="120"/>
                <TableColumn fx:id="colAmount" text="Amount" prefWidth="130"/>
                <TableColumn fx:id="colBalance" text="Balance" prefWidth="130"/>
                <TableColumn fx:id="colFundTransfer" text="Fund Transfer" prefWidth="120"/>
                <TableColumn fx:id="colRemarks" text="Remarks" prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
